' gen_ship_models.bas -- writes assets/models_ships_v2.e3d: the v2 player ship and boss meshes (#415).
' Edit the designs here, then regenerate (from the repo root):
'   tools/dev shell './tools/buildqb tools/gen_ship_models.bas && builds/gen_ship_models'
' Axes as models.e3d: X forward, Y up, Z left. The player's tail is at -X (seen from behind);
' a boss's face is at -X (seen head-on). Each part is a convex solid; PartEnd turns every face
' outward, so the order the corners are given in does not matter. Z-mirrored parts are built
' twice with gmSign = 1 and -1.
$Console:Only
Option _Explicit

Const GM_VMAX = 2400
Const GM_FMAX = 1400
Const GM_PI = 3.14159265

Dim Shared gmVX(1 To GM_VMAX) As Single, gmVY(1 To GM_VMAX) As Single, gmVZ(1 To GM_VMAX) As Single
Dim Shared gmVN As Integer
Dim Shared gmFV(1 To GM_FMAX, 1 To 4) As Integer
Dim Shared gmFK(1 To GM_FMAX) As Integer
Dim Shared gmFC(1 To GM_FMAX) As Long
Dim Shared gmFN As Integer
Dim Shared gmSign As Single
Dim Shared gmPartV As Integer, gmPartF As Integer
Dim Shared gmOut As String

Dim Shared lfX(1 To 16) As Single, lfCY(1 To 16) As Single, lfCZ(1 To 16) As Single
Dim Shared lfHY(1 To 16) As Single, lfHZ(1 To 16) As Single, lfC(1 To 16) As Long
Dim Shared lfN As Integer

Dim Shared pgA(1 To 16) As Single, pgB(1 To 16) As Single

Dim gmFile As Integer

gmSign = 1
gmOut = "# Super Spaceguy Shooter -- v2 player ship and boss models (#415): the visuals of the player and the bosses; hitboxes still come from the old PLAYER and BOSS meshes in models.e3d" + Chr$(10)
gmOut = gmOut + "# Same format and axes as models.e3d: X=forward, Y=up, Z=left. Generated by tools/gen_ship_models.bas; edit the design, not this file." + Chr$(10) + Chr$(10)

BuildPlayer
BuildBastion
BuildHydra
BuildOrbiter

gmFile = FreeFile
Open _StartDir$ + "/assets/models_ships_v2.e3d" For Output As #gmFile
Print #gmFile, gmOut;
Close #gmFile
Print "wrote assets/models_ships_v2.e3d"
System 0

Function GC& (r As Integer, g As Integer, b As Integer)
    GC& = r * 65536 + g * 256 + b
End Function

Function GV% (x As Single, y As Single, z As Single)
    gmVN = gmVN + 1
    gmVX(gmVN) = x : gmVY(gmVN) = y : gmVZ(gmVN) = z * gmSign
    GV% = gmVN
End Function

Sub F3 (a As Integer, b As Integer, c As Integer, clr As Long)
    gmFN = gmFN + 1
    gmFK(gmFN) = 3 : gmFC(gmFN) = clr
    gmFV(gmFN, 1) = a : gmFV(gmFN, 2) = b : gmFV(gmFN, 3) = c
End Sub

Sub F4 (a As Integer, b As Integer, c As Integer, d As Integer, clr As Long)
    gmFN = gmFN + 1
    gmFK(gmFN) = 4 : gmFC(gmFN) = clr
    gmFV(gmFN, 1) = a : gmFV(gmFN, 2) = b : gmFV(gmFN, 3) = c : gmFV(gmFN, 4) = d
End Sub

Sub PartBegin
    gmPartV = gmVN : gmPartF = gmFN
End Sub

Sub PartEnd
    Dim i As Integer, k As Integer, n As Integer, t As Integer
    Dim cx As Single, cy As Single, cz As Single
    Dim fx As Single, fy As Single, fz As Single
    Dim e1x As Single, e1y As Single, e1z As Single, e2x As Single, e2y As Single, e2z As Single
    Dim nx As Single, ny As Single, nz As Single
    n = gmVN - gmPartV
    For i = gmPartV + 1 To gmVN
        cx = cx + gmVX(i) : cy = cy + gmVY(i) : cz = cz + gmVZ(i)
    Next i
    cx = cx / n : cy = cy / n : cz = cz / n
    For i = gmPartF + 1 To gmFN
        fx = 0 : fy = 0 : fz = 0
        For k = 1 To gmFK(i)
            fx = fx + gmVX(gmFV(i, k)) : fy = fy + gmVY(gmFV(i, k)) : fz = fz + gmVZ(gmFV(i, k))
        Next k
        fx = fx / gmFK(i) : fy = fy / gmFK(i) : fz = fz / gmFK(i)
        e1x = gmVX(gmFV(i, 2)) - gmVX(gmFV(i, 1)) : e1y = gmVY(gmFV(i, 2)) - gmVY(gmFV(i, 1)) : e1z = gmVZ(gmFV(i, 2)) - gmVZ(gmFV(i, 1))
        e2x = gmVX(gmFV(i, 3)) - gmVX(gmFV(i, 1)) : e2y = gmVY(gmFV(i, 3)) - gmVY(gmFV(i, 1)) : e2z = gmVZ(gmFV(i, 3)) - gmVZ(gmFV(i, 1))
        nx = e1y * e2z - e1z * e2y
        ny = e1z * e2x - e1x * e2z
        nz = e1x * e2y - e1y * e2x
        If nx * (fx - cx) + ny * (fy - cy) + nz * (fz - cz) < 0 Then
            If gmFK(i) = 3 Then
                t = gmFV(i, 2) : gmFV(i, 2) = gmFV(i, 3) : gmFV(i, 3) = t
            Else
                t = gmFV(i, 2) : gmFV(i, 2) = gmFV(i, 4) : gmFV(i, 4) = t
            End If
        End If
    Next i
End Sub

Sub Box (cx As Single, cy As Single, cz As Single, hx As Single, hy As Single, hz As Single, clr As Long)
    Dim v(0 To 7) As Integer, i As Integer
    PartBegin
    For i = 0 To 7
        v(i) = GV(cx + hx * (((i And 1) * 2) - 1), cy + hy * ((((i \ 2) And 1) * 2) - 1), cz + hz * ((((i \ 4) And 1) * 2) - 1))
    Next i
    F4 v(0), v(1), v(3), v(2), clr
    F4 v(4), v(5), v(7), v(6), clr
    F4 v(0), v(1), v(5), v(4), clr
    F4 v(2), v(3), v(7), v(6), clr
    F4 v(0), v(2), v(6), v(4), clr
    F4 v(1), v(3), v(7), v(5), clr
    PartEnd
End Sub

Sub LRing (x As Single, cy As Single, cz As Single, hy As Single, hz As Single, clr As Long)
    lfN = lfN + 1
    lfX(lfN) = x : lfCY(lfN) = cy : lfCZ(lfN) = cz : lfHY(lfN) = hy : lfHZ(lfN) = hz : lfC(lfN) = clr
End Sub

' Rings given with LRing, front to back along X, joined by n-sided bands (a zero-size ring is a point).
' A band takes the colour of its far ring; capA closes the first ring and capB the last (-1 = open).
Sub Loft (n As Integer, capA As Long, capB As Long)
    Dim rv(1 To 16, 0 To 15) As Integer, tip(1 To 16) As Integer
    Dim ri As Integer, k As Integer, k2 As Integer, a As Single
    PartBegin
    For ri = 1 To lfN
        If lfHY(ri) < .0001 And lfHZ(ri) < .0001 Then
            tip(ri) = -1
            rv(ri, 0) = GV(lfX(ri), lfCY(ri), lfCZ(ri))
        Else
            tip(ri) = 0
            For k = 0 To n - 1
                a = 2 * GM_PI * (k + .5) / n
                rv(ri, k) = GV(lfX(ri), lfCY(ri) + lfHY(ri) * Sin(a) / Cos(GM_PI / n), lfCZ(ri) + lfHZ(ri) * Cos(a) / Cos(GM_PI / n))
            Next k
        End If
    Next ri
    For ri = 2 To lfN
        For k = 0 To n - 1
            k2 = (k + 1) Mod n
            If tip(ri - 1) Then
                F3 rv(ri - 1, 0), rv(ri, k2), rv(ri, k), lfC(ri)
            ElseIf tip(ri) Then
                F3 rv(ri - 1, k), rv(ri - 1, k2), rv(ri, 0), lfC(ri)
            Else
                F4 rv(ri - 1, k), rv(ri - 1, k2), rv(ri, k2), rv(ri, k), lfC(ri)
            End If
        Next k
    Next ri
    If capA >= 0 And tip(1) = 0 Then
        If n = 4 Then
            F4 rv(1, 0), rv(1, 1), rv(1, 2), rv(1, 3), capA
        Else
            For k = 1 To n - 2 : F3 rv(1, 0), rv(1, k), rv(1, k + 1), capA : Next k
        End If
    End If
    If capB >= 0 And tip(lfN) = 0 Then
        If n = 4 Then
            F4 rv(lfN, 0), rv(lfN, 1), rv(lfN, 2), rv(lfN, 3), capB
        Else
            For k = 1 To n - 2 : F3 rv(lfN, 0), rv(lfN, k), rv(lfN, k + 1), capB : Next k
        End If
    End If
    PartEnd
    lfN = 0
End Sub

Sub PG (i As Integer, a As Single, b As Single)
    pgA(i) = a : pgB(i) = b
End Sub

Sub PGEllipse (n As Integer, ra As Single, rb As Single)
    Dim i As Integer, t As Single
    For i = 1 To n
        t = 2 * GM_PI * (i - 1) / n
        pgA(i) = ra * Cos(t) : pgB(i) = rb * Sin(t)
    Next i
End Sub

' The convex polygon in pgA/pgB, extruded from lo to hi. kind 0: points are (x, z), extruded along Y.
' kind 1: points are (x, y), extruded along Z. The hi end is scaled about the polygon's centre by topScale.
Sub PolyPrism (kind As Integer, n As Integer, lo As Single, hi As Single, topScale As Single, clrSide As Long, clrTop As Long, clrBot As Long)
    Dim bi(1 To 16) As Integer, ti(1 To 16) As Integer
    Dim i As Integer, i2 As Integer
    Dim ca As Single, cb As Single, ta As Single, tb As Single
    For i = 1 To n : ca = ca + pgA(i) : cb = cb + pgB(i) : Next i
    ca = ca / n : cb = cb / n
    PartBegin
    For i = 1 To n
        ta = ca + (pgA(i) - ca) * topScale : tb = cb + (pgB(i) - cb) * topScale
        If kind = 0 Then
            bi(i) = GV(pgA(i), lo, pgB(i)) : ti(i) = GV(ta, hi, tb)
        Else
            bi(i) = GV(pgA(i), pgB(i), lo) : ti(i) = GV(ta, tb, hi)
        End If
    Next i
    For i = 1 To n
        i2 = i Mod n + 1
        F4 bi(i), bi(i2), ti(i2), ti(i), clrSide
    Next i
    If n = 4 Then
        F4 ti(1), ti(2), ti(3), ti(4), clrTop
        F4 bi(1), bi(2), bi(3), bi(4), clrBot
    Else
        For i = 2 To n - 1
            F3 ti(1), ti(i), ti(i + 1), clrTop
            F3 bi(1), bi(i), bi(i + 1), clrBot
        Next i
    End If
    PartEnd
End Sub

Function Fm$ (v As Single)
    Dim r As Single
    r = Int(Abs(v) * 10000 + .5) / 10000
    If v < 0 And r > 0 Then r = -r
    Fm$ = LTrim$(Str$(r))
End Function

Sub MeshEnd (nm As String)
    Dim i As Integer, k As Integer, c As Long
    Dim hx As Single, hy As Single, hz As Single
    For i = 1 To gmVN
        If Abs(gmVX(i)) > hx Then hx = Abs(gmVX(i))
        If Abs(gmVY(i)) > hy Then hy = Abs(gmVY(i))
        If Abs(gmVZ(i)) > hz Then hz = Abs(gmVZ(i))
    Next i
    gmOut = gmOut + "o " + nm + Chr$(10) + "aabb " + Fm$(hx) + " " + Fm$(hy) + " " + Fm$(hz) + Chr$(10)
    For i = 1 To gmVN
        gmOut = gmOut + "v " + Fm$(gmVX(i)) + " " + Fm$(gmVY(i)) + " " + Fm$(gmVZ(i)) + Chr$(10)
    Next i
    For i = 1 To gmFN
        If gmFK(i) = 3 Then gmOut = gmOut + "f" Else gmOut = gmOut + "q"
        For k = 1 To gmFK(i) : gmOut = gmOut + " " + LTrim$(Str$(gmFV(i, k))) : Next k
        c = gmFC(i)
        gmOut = gmOut + Str$(c \ 65536) + Str$((c \ 256) And 255) + Str$(c And 255) + Chr$(10)
    Next i
    gmOut = gmOut + "end" + Chr$(10) + Chr$(10)
    Print nm; " verts="; gmVN; " faces="; gmFN; " aabb"; hx; hy; hz
    gmVN = 0 : gmFN = 0
End Sub

' ---------------------------------------------------------------- player
' Seen from behind and above: a wide swept delta with blue top surfaces, upright blue tail fins,
' a dorsal fin, a big central nozzle (the thruster disc is drawn 0.08 behind it) and two glowing side engines.
Sub BuildPlayer
    Dim hull As Long, hullDk As Long, blue As Long, blueDk As Long, dark As Long, glass As Long, glow As Long, metal As Long
    Dim s As Integer
    hull = GC(196, 204, 224) : hullDk = GC(128, 138, 162) : blue = GC(36, 104, 230) : blueDk = GC(24, 66, 170)
    dark = GC(24, 26, 36) : glass = GC(100, 235, 255) : glow = GC(255, 205, 120) : metal = GC(110, 116, 134)

    LRing -.7, 0, 0, .14, .17, hull
    LRing -.25, .02, 0, .19, .24, hull
    LRing .25, 0, 0, .13, .16, hull
    LRing .7, -.03, 0, .05, .05, blue
    LRing .84, -.04, 0, 0, 0, blue
    Loft 6, dark, -1

    LRing -.84, 0, 0, .17, .17, metal
    LRing -.62, 0, 0, .14, .14, hullDk
    Loft 8, dark, -1

    LRing -.1, .17, 0, .05, .08, glass
    LRing .15, .19, 0, .07, .11, glass
    LRing .42, .13, 0, .03, .05, glass
    Loft 6, glass, glass

    PG 1, -.1, -.04 : PG 2, -.66, -.04 : PG 3, -.8, .285 : PG 4, -.52, .285
    PolyPrism 1, 4, -.045, .045, 1, blue, blueDk, blueDk

    For s = 1 To -1 Step -2
        gmSign = s
        PG 1, .45, .14 : PG 2, -.2, .76 : PG 3, -.7, .76 : PG 4, -.8, .14
        PolyPrism 0, 4, -.05, .03, .72, hull, blue, hullDk
        PG 1, -.3, .02 : PG 2, -.72, .02 : PG 3, -.8, .285 : PG 4, -.56, .285
        PolyPrism 1, 4, .66, .73, 1, blue, blueDk, blue
        LRing -.8, -.01, .36, .085, .085, metal
        LRing -.3, 0, .36, .075, .075, hullDk
        LRing .1, 0, .36, .05, .05, hull
        Loft 6, glow, -1
    Next s
    gmSign = 1
    MeshEnd "S2_PLAYER"
End Sub

' ---------------------------------------------------------------- boss: Bastion (the revised original)
' A wide dark gunship, a glowing eye in a red frame, a heavy cannon either side of it, red-edged swept wings with a weapon pod on each tip.
Sub BuildBastion
    Dim hull As Long, plate As Long, dark As Long, red As Long, glow As Long, metal As Long
    Dim s As Integer
    hull = GC(112, 118, 142) : plate = GC(160, 168, 196) : dark = GC(60, 62, 80) : red = GC(255, 50, 60)
    glow = GC(255, 235, 120) : metal = GC(170, 176, 196)

    LRing -1.9, 0, 0, .45, .8, plate
    LRing -.9, 0, 0, .78, 1.45, hull
    LRing .8, 0, 0, .8, 1.75, hull
    LRing 2, 0, 0, .55, 1.2, dark
    Loft 8, dark, dark

    LRing -2.35, .05, 0, 0, 0, glow
    LRing -1.95, .05, 0, .34, .34, glow
    LRing -1.88, .05, 0, .46, .46, red
    Loft 8, -1, -1

    LRing -.5, .78, 0, .12, .42, plate
    LRing .3, .78, 0, .12, .5, plate
    LRing 1.2, .7, 0, .08, .3, hull
    Loft 6, dark, dark
    Box -.5, .78, 0, .03, .05, .3, glow

    Box -1.55, -.55, 0, .4, .14, .6, dark

    For s = 1 To -1 Step -2
        gmSign = s
        PG 1, -1, 1.3 : PG 2, .9, 4.78 : PG 3, 1.9, 4.78 : PG 4, 2, 1.3
        PolyPrism 0, 4, -.14, .14, .6, red, plate, dark

        LRing -1.55, 0, 4.2, .16, .16, metal
        LRing -1.35, 0, 4.2, .24, .24, red
        LRing -.5, 0, 4.2, .26, .26, hull
        LRing 1.3, 0, 4.2, .22, .22, hull
        Loft 6, glow, dark

        LRing -2.45, -.28, 1.55, .17, .17, metal
        LRing -2.3, -.28, 1.55, .27, .27, red
        LRing -2.16, -.28, 1.55, .2, .2, metal
        LRing -1, -.28, 1.55, .3, .3, hull
        LRing .2, -.28, 1.55, .34, .34, hull
        Loft 6, dark, dark
    Next s
    gmSign = 1
    MeshEnd "S2_BOSS_BASTION"
End Sub

' ---------------------------------------------------------------- boss: Hydra
' Three glowing-eyed heads in a row on a wide plate, ivory fangs at both tips and a pair of tusks under the centre head.
Sub BuildHydra
    Dim hull As Long, plate As Long, dark As Long, glow As Long, horn As Long, acc As Long
    Dim s As Integer
    hull = GC(62, 120, 84) : plate = GC(96, 170, 116) : dark = GC(36, 56, 46) : glow = GC(210, 255, 110)
    horn = GC(245, 243, 215) : acc = GC(150, 235, 80)

    PG 1, -.3, -4.4 : PG 2, 1.6, -4.78 : PG 3, 2.4, -2.2 : PG 4, 2.4, 2.2 : PG 5, 1.6, 4.78 : PG 6, -.3, 4.4
    PolyPrism 0, 6, -.1, .1, .85, hull, plate, dark

    LRing -2.42, 0, 0, 0, 0, glow
    LRing -2.05, 0, 0, .32, .32, glow
    LRing -1.8, 0, 0, .55, .55, dark
    LRing -.6, 0, 0, .82, .82, hull
    LRing 1.4, 0, 0, .7, .8, hull
    Loft 8, glow, dark

    PG 1, -.6, .65 : PG 2, 1.3, .72 : PG 3, 1.6, .93 : PG 4, -.1, .93
    PolyPrism 1, 4, -.07, .07, 1, acc, acc, acc

    For s = 1 To -1 Step -2
        gmSign = s
        LRing -1.55, 0, 2.7, 0, 0, glow
        LRing -1.2, 0, 2.7, .24, .24, glow
        LRing -.95, 0, 2.7, .42, .42, dark
        LRing -.1, 0, 2.7, .62, .62, hull
        LRing 1.4, 0, 2.7, .55, .6, hull
        Loft 8, glow, dark

        LRing -1.1, 0, 4.45, 0, 0, horn
        LRing .1, 0, 4.45, .2, .2, horn
        LRing 1.5, 0, 4.45, .24, .24, hull
        Loft 4, -1, dark

        LRing -2.45, -.55, .55, 0, 0, horn
        LRing -1.6, -.55, .55, .14, .14, horn
        LRing -.6, -.5, .45, .2, .2, hull
        Loft 4, -1, -1

        Box .9, 0, 1.45, .8, .26, .62, hull
        Box .9, 0, 3.6, .8, .22, .7, hull
    Next s
    gmSign = 1
    MeshEnd "S2_BOSS_HYDRA"
End Sub

' ---------------------------------------------------------------- boss: Orbiter
' A flat saucer with a glowing rim, a big eye pod on the front of its dome, a cannon on each side of the pod and a turret on each rim tip.
Sub BuildOrbiter
    Dim hull As Long, plate As Long, dark As Long, glow As Long, rim As Long, metal As Long
    Dim s As Integer
    hull = GC(118, 92, 180) : plate = GC(170, 142, 230) : dark = GC(52, 42, 86) : glow = GC(130, 245, 255)
    rim = GC(255, 110, 215) : metal = GC(190, 180, 225)

    PGEllipse 12, 2.45, 4.7
    PolyPrism 0, 12, 0, -.42, .55, hull, dark, hull
    PolyPrism 0, 12, 0, .32, .6, plate, hull, hull
    PGEllipse 12, 2.5, 4.78
    PolyPrism 0, 12, -.07, .07, 1, glow, glow, glow

    LRing -1.95, .2, 0, 0, 0, glow
    LRing -1.45, .2, 0, .42, .42, glow
    LRing -1.15, .2, 0, .62, .62, rim
    LRing -.1, .2, 0, .66, .85, plate
    LRing 1, .2, 0, .4, .6, hull
    Loft 8, glow, hull

    For s = 1 To -1 Step -2
        gmSign = s
        LRing -2.5, -.04, 2.4, .12, .12, metal
        LRing -2.35, -.04, 2.4, .2, .2, rim
        LRing -2.2, -.04, 2.4, .15, .15, metal
        LRing -1.2, -.04, 2.4, .22, .22, hull
        Loft 6, glow, hull

        LRing -.9, 0, 4.3, .1, .1, metal
        LRing -.6, 0, 4.3, .18, .18, rim
        LRing .5, 0, 4.3, .2, .2, hull
        Loft 6, glow, hull
    Next s
    gmSign = 1
    MeshEnd "S2_BOSS_ORBITER"
End Sub
