# Headless build/test environment for Super Spaceguy Shooter.
# Mirrors the Linux job in .github/workflows/build.yml. Use it through
# tools/dev; the repo is bind-mounted at run time, never copied in.
FROM docker.io/library/ubuntu:24.04

# Must match QB64PE_VERSION in .github/workflows/build.yml and the local dev
# install (CLAUDE.md). Bump all three together.
ARG QB64PE_VERSION=v4.5.0
ARG QB64PE_ASSET=qb64pe_lnx-4.5.0.tar.gz
ARG NODE_VERSION=22.20.0

ENV DEBIAN_FRONTEND=noninteractive

# First line: CI's apt list. Second: what setup_lnx.sh would sudo-install.
# Third: tools the repo scripts call (make-version, http mock, xvfb-run, emit).
# Fourth: runtime for `tools/dev run` (Mesa GL drivers for /dev/dri, Pulse client for audio).
# Fifth: `tools/dev record` (a null-sink PulseAudio server to capture the game's sound, ffmpeg).
RUN apt-get update -qq \
 && apt-get install -y --no-install-recommends \
      libgl1-mesa-dev libglu1-mesa-dev libasound2-dev libx11-dev libxext-dev libpng-dev xvfb libcurl4-openssl-dev \
      build-essential x11-utils mesa-common-dev libxcursor-dev libxrandr-dev libxinerama-dev libxi-dev \
      ca-certificates curl git python3 xauth xz-utils \
      libgl1-mesa-dri libglx-mesa0 libpulse0 \
      pulseaudio pulseaudio-utils ffmpeg \
 && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" \
      | tar xJ -C /usr/local --strip-components=1 \
      --exclude='*/CHANGELOG.md' --exclude='*/LICENSE' --exclude='*/README.md' \
 && node --version && npm --version

# setup_lnx.sh refuses to run as root, so build QB64-PE as a throwaway user.
# The tree is then made world-writable: QB64-PE writes internal/temp on every
# compile, and tools/buildqb links <qb64pe dir>/assets to the mounted repo,
# both as whatever uid tools/dev runs the container with.
RUN useradd -m qbbuild \
 && curl -fsSL -o /tmp/qb64pe.tar.gz \
      "https://github.com/QB64-Phoenix-Edition/QB64pe/releases/download/${QB64PE_VERSION}/${QB64PE_ASSET}" \
 && tar xzf /tmp/qb64pe.tar.gz -C /opt \
 && rm /tmp/qb64pe.tar.gz \
 && chown -R qbbuild:qbbuild /opt/qb64pe \
 && su qbbuild -c 'mkdir -p ~/.local/share/applications && cd /opt/qb64pe && bash setup_lnx.sh 1' \
 && test -x /opt/qb64pe/qb64pe \
 && chmod -R a+rwX /opt/qb64pe \
 && ln -s /opt/qb64pe/qb64pe /usr/local/bin/qb64pe \
 && userdel -r qbbuild

# The repo is mounted with the host user's uid; don't let git balk at it.
RUN git config --system --add safe.directory '*'

ENV QB64_BIN_DIR=/opt/qb64pe \
    HOME=/tmp/home \
    npm_config_update_notifier=false

RUN mkdir -p /tmp/home && chmod 1777 /tmp/home
