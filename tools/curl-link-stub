#!/usr/bin/env bash
# Linux only (#303): builds an unversioned libcurl link stub in DIR and prints the
# linker flag that puts it ahead of the system libcurl.so.
#
# Debian/Ubuntu's libcurl tags every symbol with a version (CURL_OPENSSL_4), and a
# binary linked against it records that requirement. Fedora's libcurl has no symbol
# versions, so its loader prints "libcurl.so.4: no version information available"
# on every launch. Linking against a stub with the same soname and symbol names but
# no versions records plain references, which bind to any distro's libcurl.so.4.
# Only the link sees the stub; at run time the binary loads the system libcurl.
#
# Usage: tools/curl-link-stub DIR   ->  prints "-LDIR"
set -euo pipefail

dir="${1:?usage: $0 DIR}"
cc="${CC:-gcc}"

lib="$("$cc" -print-file-name=libcurl.so)"
[ -f "$lib" ] || { echo "curl-link-stub: libcurl.so not found (install libcurl4-openssl-dev)" >&2; exit 1; }
soname="$(objdump -p "$lib" | awk '$1 == "SONAME" { print $2 }')"
[ -n "$soname" ] || { echo "curl-link-stub: no SONAME in $lib" >&2; exit 1; }

mkdir -p "$dir"
nm -D --defined-only "$lib" | awk '
    { sub(/@.*/, "", $3) }
    $2 ~ /^[TWi]$/  { print "void " $3 "(void) {}" }
    $2 ~ /^[DBRV]$/ { print "char " $3 ";" }
' > "$dir/curl_stub.c"
grep -q '^void curl_easy_init(' "$dir/curl_stub.c" || { echo "curl-link-stub: no curl symbols read from $lib" >&2; exit 1; }

"$cc" -shared -fPIC -w -Wl,-soname,"$soname" -o "$dir/libcurl.so" "$dir/curl_stub.c"
echo "-L$dir"
