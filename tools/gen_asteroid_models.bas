' gen_asteroid_models.bas -- writes assets/models_asteroids_v2.e3d: the four v2 asteroid shapes (#436).
' Edit the designs here, then regenerate (from the repo root):
'   tools/dev shell bash -c './tools/buildqb tools/gen_asteroid_models.bas && builds/gen_asteroid_models'
' The generator is seeded (RNG_Seed below), so the same source always writes the same file.
' Face budgets (triangles only; the old ASTEROID mesh has 192):
'   A2_CHUNK   36   blocky boulder, about 1.2:1:1, a few large flat facets
'   A2_SHARD   50   elongated tapered shard, about 1.7:1:1
'   A2_CRATER  64   rounder body with one big dished crater (darker floor) and two dents
'   A2_SPLIT   48   contact binary: two unequal overlapping lumps with a notch between them
' Every mesh is centred on its bounding box and scaled so the RMS vertex radius is AG_RMS,
' the old asteroid's, which keeps on-screen size and the 80-unit blob-to-mesh handoff unchanged.
' Each mesh's aabb line is its vertex extents. Axes as models.e3d: X forward, Y up, Z left.
' Each shape is a latitude/longitude solid: rings of AG_S vertices joined by triangle bands,
' closed by a pole vertex or a flat polygon cap. Every face winds outward in construction.
$Console:Only
Option _Explicit
'$INCLUDE:'../src/sys/failfast.bi'
'$INCLUDE:'../src/sys/rng.bas'

Const AG_VMAX = 200
Const AG_FMAX = 200
Const AG_PI = 3.14159265
Const AG_RMS = 0.62

Dim Shared agVX(1 To AG_VMAX) As Single, agVY(1 To AG_VMAX) As Single, agVZ(1 To AG_VMAX) As Single
Dim Shared agVN As Integer
Dim Shared agFV(1 To AG_FMAX, 1 To 3) As Integer
Dim Shared agFC(1 To AG_FMAX) As Long
Dim Shared agFN As Integer
Dim Shared agPartV As Integer, agPartF As Integer
Dim Shared agOut As String

' ring description: axial position and radius of each ring, poles' axial positions (a pole is a vertex on the axis)
Dim Shared rgAx(1 To 8) As Single, rgRd(1 To 8) As Single
Dim Shared rgPoleTop As Single, rgPoleBot As Single
Dim Shared rgFlatCaps As Integer
Dim Shared dnRing(1 To 4) As Integer, dnK(1 To 4) As Integer, dnF(1 To 4) As Single, dnN As Integer
Dim Shared agDent(1 To AG_VMAX) As Integer
Dim Shared agToneA As Long, agToneB As Long, agToneC As Long, agToneFloor As Long, agToneDent As Long

Dim agFile As Integer

RNG_Seed 436
agToneA = GC(255, 156, 64) : agToneB = GC(204, 124, 52) : agToneC = GC(255, 184, 108)
agToneFloor = GC(138, 84, 38) : agToneDent = GC(160, 98, 44)
agOut = "# Super Spaceguy Shooter -- v2 asteroid models (#436): four low-poly shapes, flat shaded, each normalised to the old asteroid's RMS radius" + Chr$(10)
agOut = agOut + "# Same format and axes as models.e3d: X=forward, Y=up, Z=left. Generated by tools/gen_asteroid_models.bas; edit the design, not this file." + Chr$(10) + Chr$(10)

BuildChunk
BuildShard
BuildCrater
BuildSplit

agFile = FreeFile
Open _StartDir$ + "/assets/models_asteroids_v2.e3d" For Output As #agFile
Print #agFile, agOut;
Close #agFile
Print "wrote assets/models_asteroids_v2.e3d"
System 0

Function GC& (r As Integer, g As Integer, b As Integer)
    GC& = r * 65536 + g * 256 + b
End Function

Function GV% (x As Single, y As Single, z As Single)
    agVN = agVN + 1
    agVX(agVN) = x : agVY(agVN) = y : agVZ(agVN) = z
    agDent(agVN) = 0
    GV% = agVN
End Function

Sub F3 (a As Integer, b As Integer, c As Integer, clr As Long)
    agFN = agFN + 1
    agFC(agFN) = clr
    agFV(agFN, 1) = a : agFV(agFN, 2) = b : agFV(agFN, 3) = c
End Sub

Function JitV! (amount As Single)
    JitV! = (RNG!(RNG_GAME) - .5) * 2 * amount
End Function

' One of the three base tones, so the per-asteroid tint still varies a shape's faces.
Function Tone& (a As Integer, b As Integer, c As Integer)
    Dim t As Single
    t = RNG!(RNG_GAME)
    If agDent(a) <> 0 Or agDent(b) <> 0 Or agDent(c) <> 0 Then Tone& = agToneDent : Exit Function
    If t < .4 Then
        Tone& = agToneA
    ElseIf t < .75 Then
        Tone& = agToneB
    Else
        Tone& = agToneC
    End If
End Function

' Builds one lump at (cx,cy,cz), scaled by (sx,sy,sz), from the rings in rgAx/rgRd. axisX = 0: the axis is Y; -1: the axis is X.
' nRings rings of nSeg vertices; alternate rings are turned half a step so the bands are even triangles.
' rgPoleTop/rgPoleBot are the axial positions of the pole vertices, or flat polygon caps when rgFlatCaps is set.
' floorDark colours the top pole's fan with the crater-floor tone.
Sub Lump (cx As Single, cy As Single, cz As Single, sx As Single, sy As Single, sz As Single, nSeg As Integer, nRings As Integer, axisX As Integer, jit As Single, floorDark As Integer)
    Dim rv(1 To 8, 0 To 11) As Integer
    Dim poleT As Integer, poleB As Integer
    Dim j As Integer, k As Integer, k2 As Integer, sh As Integer
    Dim ph As Single, rd As Single, ax As Single, px As Single, py As Single, pz As Single
    Dim ref As Integer, i As Integer, t As Integer
    Dim ccx As Single, ccy As Single, ccz As Single
    Dim fx As Single, fy As Single, fz As Single, nx As Single, ny As Single, nz As Single
    Dim e1x As Single, e1y As Single, e1z As Single, e2x As Single, e2y As Single, e2z As Single
    Dim clr As Long, nv As Integer

    agPartV = agVN : agPartF = agFN
    For j = 1 To nRings
        For k = 0 To nSeg - 1
            ph = 2 * AG_PI * (k + ((j - 1) Mod 2) * .5 + JitV!(jit * .35)) / nSeg
            rd = rgRd(j) * (1 + JitV!(jit))
            ax = rgAx(j) + JitV!(jit * .4)
            If axisX Then
                px = ax : py = rd * Cos(ph) : pz = rd * Sin(ph)
            Else
                px = rd * Cos(ph) : py = ax : pz = rd * Sin(ph)
            End If
            rv(j, k) = GV(cx + px * sx, cy + py * sy, cz + pz * sz)
        Next k
    Next j
    If rgFlatCaps = 0 Then
        If axisX Then
            poleT = GV(cx + rgPoleTop * sx, cy, cz) : poleB = GV(cx + rgPoleBot * sx, cy, cz)
        Else
            poleT = GV(cx, cy + rgPoleTop * sy, cz) : poleB = GV(cx, cy + rgPoleBot * sy, cz)
        End If
    End If
    For i = 1 To dnN
        k = dnK(i)
        agVX(rv(dnRing(i), k)) = cx + (agVX(rv(dnRing(i), k)) - cx) * dnF(i)
        agVY(rv(dnRing(i), k)) = cy + (agVY(rv(dnRing(i), k)) - cy) * dnF(i)
        agVZ(rv(dnRing(i), k)) = cz + (agVZ(rv(dnRing(i), k)) - cz) * dnF(i)
        agDent(rv(dnRing(i), k)) = 1
    Next i

    ' top cap
    If rgFlatCaps Then
        For k = 1 To nSeg - 2
            F3 rv(1, 0), rv(1, k + 1), rv(1, k), Tone&(rv(1, 0), rv(1, k + 1), rv(1, k))
        Next k
    Else
        For k = 0 To nSeg - 1
            k2 = (k + 1) Mod nSeg
            clr = Tone&(poleT, rv(1, k2), rv(1, k))
            If floorDark Then clr = agToneFloor
            F3 poleT, rv(1, k2), rv(1, k), clr
        Next k
    End If
    ' bands: ring j (upper) to ring j+1 (lower)
    For j = 1 To nRings - 1
        sh = 0 : If (j - 1) Mod 2 = 1 Then sh = 1
        For k = 0 To nSeg - 1
            k2 = (k + 1) Mod nSeg
            F3 rv(j, k), rv(j, k2), rv(j + 1, (k + sh) Mod nSeg), Tone&(rv(j, k), rv(j, k2), rv(j + 1, (k + sh) Mod nSeg))
            F3 rv(j + 1, (k + sh) Mod nSeg), rv(j, k2), rv(j + 1, (k + sh + 1) Mod nSeg), Tone&(rv(j + 1, (k + sh) Mod nSeg), rv(j, k2), rv(j + 1, (k + sh + 1) Mod nSeg))
        Next k
    Next j
    ' bottom cap (the last faces added)
    If rgFlatCaps Then
        For k = 1 To nSeg - 2
            F3 rv(nRings, 0), rv(nRings, k), rv(nRings, k + 1), Tone&(rv(nRings, 0), rv(nRings, k), rv(nRings, k + 1))
        Next k
    Else
        For k = 0 To nSeg - 1
            k2 = (k + 1) Mod nSeg
            F3 poleB, rv(nRings, k), rv(nRings, k2), Tone&(poleB, rv(nRings, k), rv(nRings, k2))
        Next k
    End If

    ' every face was wound the same way: if the last (bottom) face points inward, the whole part is turned round
    nv = agVN - agPartV
    For i = agPartV + 1 To agVN
        ccx = ccx + agVX(i) : ccy = ccy + agVY(i) : ccz = ccz + agVZ(i)
    Next i
    ccx = ccx / nv : ccy = ccy / nv : ccz = ccz / nv
    ref = agFN
    fx = (agVX(agFV(ref, 1)) + agVX(agFV(ref, 2)) + agVX(agFV(ref, 3))) / 3 - ccx
    fy = (agVY(agFV(ref, 1)) + agVY(agFV(ref, 2)) + agVY(agFV(ref, 3))) / 3 - ccy
    fz = (agVZ(agFV(ref, 1)) + agVZ(agFV(ref, 2)) + agVZ(agFV(ref, 3))) / 3 - ccz
    e1x = agVX(agFV(ref, 2)) - agVX(agFV(ref, 1)) : e1y = agVY(agFV(ref, 2)) - agVY(agFV(ref, 1)) : e1z = agVZ(agFV(ref, 2)) - agVZ(agFV(ref, 1))
    e2x = agVX(agFV(ref, 3)) - agVX(agFV(ref, 1)) : e2y = agVY(agFV(ref, 3)) - agVY(agFV(ref, 1)) : e2z = agVZ(agFV(ref, 3)) - agVZ(agFV(ref, 1))
    nx = e1y * e2z - e1z * e2y : ny = e1z * e2x - e1x * e2z : nz = e1x * e2y - e1y * e2x
    If nx * fx + ny * fy + nz * fz < 0 Then
        For i = agPartF + 1 To agFN
            t = agFV(i, 2) : agFV(i, 2) = agFV(i, 3) : agFV(i, 3) = t
        Next i
    End If
    dnN = 0
End Sub

Function Fm$ (v As Single)
    Dim r As Single
    r = Int(Abs(v) * 10000 + .5) / 10000
    If v < 0 And r > 0 Then r = -r
    Fm$ = LTrim$(Str$(r))
End Function

' Centres the mesh on its bounding box, scales it to the RMS radius AG_RMS, writes it and prints its statistics.
Sub MeshEnd (nm As String)
    Dim i As Integer, k As Integer, c As Long
    Dim lx As Single, ly As Single, lz As Single, ux As Single, uy As Single, uz As Single
    Dim mx As Single, my As Single, mz As Single, sc As Single
    Dim sq As Single, rmsR As Single, maxR As Single, r As Single
    Dim hx As Single, hy As Single, hz As Single, rmx As Single, rmn As Single
    lx = agVX(1) : ux = lx : ly = agVY(1) : uy = ly : lz = agVZ(1) : uz = lz
    For i = 2 To agVN
        If agVX(i) < lx Then lx = agVX(i)
        If agVX(i) > ux Then ux = agVX(i)
        If agVY(i) < ly Then ly = agVY(i)
        If agVY(i) > uy Then uy = agVY(i)
        If agVZ(i) < lz Then lz = agVZ(i)
        If agVZ(i) > uz Then uz = agVZ(i)
    Next i
    mx = (lx + ux) / 2 : my = (ly + uy) / 2 : mz = (lz + uz) / 2
    For i = 1 To agVN
        agVX(i) = agVX(i) - mx : agVY(i) = agVY(i) - my : agVZ(i) = agVZ(i) - mz
        sq = sq + agVX(i) * agVX(i) + agVY(i) * agVY(i) + agVZ(i) * agVZ(i)
    Next i
    sc = AG_RMS / Sqr(sq / agVN)
    For i = 1 To agVN
        agVX(i) = agVX(i) * sc : agVY(i) = agVY(i) * sc : agVZ(i) = agVZ(i) * sc
        If Abs(agVX(i)) > hx Then hx = Abs(agVX(i))
        If Abs(agVY(i)) > hy Then hy = Abs(agVY(i))
        If Abs(agVZ(i)) > hz Then hz = Abs(agVZ(i))
        r = Sqr(agVX(i) * agVX(i) + agVY(i) * agVY(i) + agVZ(i) * agVZ(i))
        If r > maxR Then maxR = r
        rmsR = rmsR + r * r
    Next i
    rmsR = Sqr(rmsR / agVN)
    rmx = hx : If hy > rmx Then rmx = hy
    If hz > rmx Then rmx = hz
    rmn = hx : If hy < rmn Then rmn = hy
    If hz < rmn Then rmn = hz
    agOut = agOut + "o " + nm + Chr$(10) + "aabb " + Fm$(hx) + " " + Fm$(hy) + " " + Fm$(hz) + Chr$(10)
    For i = 1 To agVN
        agOut = agOut + "v " + Fm$(agVX(i)) + " " + Fm$(agVY(i)) + " " + Fm$(agVZ(i)) + Chr$(10)
    Next i
    For i = 1 To agFN
        agOut = agOut + "f"
        For k = 1 To 3 : agOut = agOut + " " + LTrim$(Str$(agFV(i, k))) : Next k
        c = agFC(i)
        agOut = agOut + Str$(c \ 65536) + Str$((c \ 256) And 255) + Str$(c And 255) + Chr$(10)
    Next i
    agOut = agOut + "end" + Chr$(10) + Chr$(10)
    Print nm; " verts="; agVN; " faces="; agFN; " aabb"; hx; hy; hz; " bound_r="; maxR; " rms_r="; rmsR; " extent_ratio="; rmx / rmn
    agVN = 0 : agFN = 0
End Sub

' ---------------------------------------------------------------- chunk
' A blocky boulder: a five-sided prism that bulges at the belt, with flat polygon caps top and bottom.
Sub BuildChunk
    rgFlatCaps = -1
    rgAx(1) = .92 : rgRd(1) = .7
    rgAx(2) = .34 : rgRd(2) = 1
    rgAx(3) = -.34 : rgRd(3) = 1
    rgAx(4) = -.92 : rgRd(4) = .7
    Lump 0, 0, 0, 1.2, 1, 1, 5, 4, 0, .1, 0
    MeshEnd "A2_CHUNK"
End Sub

' ---------------------------------------------------------------- shard
' A long splinter along X: a sharp tip at +X, the fattest section behind the middle, a blunt broken end at -X.
Sub BuildShard
    rgFlatCaps = 0
    rgAx(1) = .66 : rgRd(1) = .32
    rgAx(2) = .28 : rgRd(2) = .53
    rgAx(3) = -.12 : rgRd(3) = .64
    rgAx(4) = -.5 : rgRd(4) = .6
    rgAx(5) = -.8 : rgRd(5) = .42
    rgPoleTop = 1.05 : rgPoleBot = -.92
    Lump 0, 0, 0, 1, 1, 1, 5, 5, -1, .08, 0
    MeshEnd "A2_SHARD"
End Sub

' ---------------------------------------------------------------- crater
' A rounded body whose top is a big dish: the pole is the crater floor, pushed in below the raised rim ring; two dents on the flanks.
Sub BuildCrater
    rgFlatCaps = 0
    rgAx(1) = 1 : rgRd(1) = .6
    rgAx(2) = .46 : rgRd(2) = .94
    rgAx(3) = -.2 : rgRd(3) = 1
    rgAx(4) = -.72 : rgRd(4) = .66
    rgPoleTop = .44 : rgPoleBot = -.96
    dnN = 2
    dnRing(1) = 2 : dnK(1) = 3 : dnF(1) = .74
    dnRing(2) = 3 : dnK(2) = 7 : dnF(2) = .8
    Lump 0, 0, 0, 1, 1, 1, 8, 4, 0, .05, -1
    MeshEnd "A2_CRATER"
End Sub

' ---------------------------------------------------------------- split
' Two unequal convex lumps, the small one pushed into the big one's flank at an angle: the seam between them is the notch.
Sub BuildSplit
    rgFlatCaps = 0
    rgAx(1) = .5 : rgRd(1) = .87
    rgAx(2) = -.5 : rgRd(2) = .87
    rgPoleTop = 1 : rgPoleBot = -1
    Lump -.3, -.15, -.05, .92, .86, .92, 6, 2, 0, .08, 0
    Lump .55, .5, .4, .6, .6, .6, 6, 2, 0, .08, 0
    MeshEnd "A2_SPLIT"
End Sub
