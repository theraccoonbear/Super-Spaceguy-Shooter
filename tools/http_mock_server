#!/usr/bin/env node
// http_mock_server -- programmable HTTP mock for QB64-PE HTTP queue tests.
//
// Endpoints:
//   POST /fast          200 immediately
//   POST /slow/<ms>     sleep N ms, then 200
//   POST /fail          500 immediately
//   GET  /get_ok        200 {"ok":true}
//   GET  /requests      JSON log of all received requests in order
//   DELETE /requests    clear the log
//
// Prints the bound port to stdout on startup so the wrapper can read it.
// Usage: tools/http_mock_server [--port N]
"use strict";
const http = require("http");

let log = [];

function send(res, status, body) {
  res.writeHead(status, {
    "Content-Type": "application/json",
    "Content-Length": Buffer.byteLength(body),
  });
  res.end(body);
}

function record(req, body) {
  log.push({
    seq: log.length,
    method: req.method,
    path: req.url,
    body: body,
    t: Date.now() / 1000,
  });
}

const server = http.createServer((req, res) => {
  const chunks = [];
  req.on("data", (c) => chunks.push(c));
  req.on("end", () => {
    const body = Buffer.concat(chunks).toString("utf8");
    if (req.method === "POST") {
      record(req, body);
      if (req.url === "/fast") {
        send(res, 200, '{"ok":true}');
      } else if (req.url.startsWith("/slow/")) {
        let ms = parseInt(req.url.split("/")[2], 10);
        if (Number.isNaN(ms)) ms = 100;
        setTimeout(() => send(res, 200, '{"ok":true}'), ms);
      } else if (req.url === "/fail") {
        send(res, 500, '{"error":"mock failure"}');
      } else {
        send(res, 404, '{"error":"not found"}');
      }
    } else if (req.method === "GET") {
      if (req.url === "/get_ok") {
        record(req, "");
        send(res, 200, '{"ok":true}');
      } else if (req.url === "/requests") {
        send(res, 200, JSON.stringify(log));
      } else {
        send(res, 404, '{"error":"not found"}');
      }
    } else if (req.method === "DELETE") {
      if (req.url === "/requests") {
        log = [];
        send(res, 200, '{"reset":true}');
      } else {
        send(res, 404, '{"error":"not found"}');
      }
    } else {
      send(res, 405, '{"error":"method not allowed"}');
    }
  });
});

let port = 0;
const i = process.argv.indexOf("--port");
if (i !== -1) port = parseInt(process.argv[i + 1], 10) || 0;

server.listen(port, "127.0.0.1", () => {
  console.log(server.address().port);
});
