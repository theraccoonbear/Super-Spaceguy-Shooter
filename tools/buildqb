#!/bin/bash

# --release (or SSS_RELEASE=1): a release build of sss.bas, without the dev-only flags (#275)
# --check: build nothing; exit 0 if the build output is current with its inputs, 1 if stale (#233)
check_only=0
while [ "${1:-}" = --release ] || [ "${1:-}" = --check ]; do
    case "$1" in
        --release) export SSS_RELEASE=1 ;;
        --check) check_only=1 ;;
    esac
    shift
done

if [ ! -f "$1" ]; then
    echo "Error: source file '$1' not found" >&2
    exit 1
fi

base=$(basename "$1" .bas)
# SSS_BUILD_OUT=<path>: write the executable there instead of builds/<name>
old_exe="${SSS_BUILD_OUT:-./builds/$base}"

# The hash of a build's inputs (tools/build-manifest) is stored next to the executable as
# <exe>.sha1, with the listing in <exe>.manifest, after every successful build (#233).
if [ "$check_only" = 1 ]; then
    new_manifest=$(mktemp)
    "$(dirname "$0")/build-manifest" "$1" > "$new_manifest" || { rm -f "$new_manifest"; exit 2; }
    if [ ! -x "$old_exe" ]; then
        echo "stale: $old_exe does not exist"
        rm -f "$new_manifest"
        exit 1
    fi
    if [ ! -f "$old_exe.manifest" ]; then
        echo "stale: no manifest for $old_exe (built before the staleness check, or by hand)"
        rm -f "$new_manifest"
        exit 1
    fi
    if cmp -s "$new_manifest" "$old_exe.manifest"; then
        echo "current: $old_exe"
        rm -f "$new_manifest"
        exit 0
    fi
    echo "stale: $old_exe is out of date with these inputs:"
    old_keys=$(sed 's/:[^:]*$//' "$old_exe.manifest" | LC_ALL=C sort)
    new_keys=$(sed 's/:[^:]*$//' "$new_manifest" | LC_ALL=C sort)
    LC_ALL=C comm -13 <(LC_ALL=C sort "$old_exe.manifest") <(LC_ALL=C sort "$new_manifest") | sed 's/:[^:]*$//' | while IFS= read -r key; do
        if grep -qxF -- "$key" <<< "$old_keys"; then
            echo "  changed: $key"
        else
            echo "  added:   $key"
        fi
    done
    LC_ALL=C comm -23 <(printf '%s\n' "$old_keys") <(printf '%s\n' "$new_keys") | sed 's/^/  removed: /'
    rm -f "$new_manifest"
    exit 1
fi

if [ "$1" == "sss.bas" ]; then
    echo ">>> Baking in-game spoken text..."
    "$(dirname "$0")/bake_speech_dict" || exit 1
    echo ">>> ...done!"
    echo ">>> Generating version..."
    "$(dirname "$0")/make-version.sh" || exit 1
    # Ensure assets/.env exists for $EMBED (empty = no network telemetry)
    if [ ! -f assets/.env ]; then
        touch assets/.env
    fi
    REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
    if ! git -C "$REPO_ROOT" diff --exit-code assets/speech_dict.txt > /dev/null 2>&1; then
        echo ""
        echo "!!! speech_dict.txt was stale and has been updated." >&2
        echo "!!! You must commit it before pushing:" >&2
        echo "!!!   git add assets/speech_dict.txt && git commit" >&2
        echo ""
    fi
fi

# QB64-PE resolves $EMBED paths relative to its binary directory.
# Create assets -> repo/assets there so '$EMBED:assets/...' works
# regardless of where qb64pe is installed or where the repo lives.
QB64_BIN=$(which qb64pe 2>/dev/null)
if [ -z "$QB64_BIN" ]; then
    echo "Error: qb64pe not found in PATH" >&2
    exit 1
fi
QB64_DIR="$(dirname "$(realpath "$QB64_BIN")")"
# On native Windows, plain `ln -sfn` can't replace an existing real directory --
# it links *inside* it instead, leaving a stale nested assets/assets that $EMBED
# resolves against instead of the real repo assets. Mirror the PowerShell Junction
# approach .github/scripts/qb64build.sh already uses for CI's Windows runner.
case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*)
        WIN_LINK=$(cygpath -w "$QB64_DIR/assets")
        WIN_TARGET=$(cygpath -w "$(realpath .)/assets")
        WIN_LINK="$WIN_LINK" WIN_TARGET="$WIN_TARGET" \
            powershell -Command 'if (Test-Path $env:WIN_LINK) { Remove-Item $env:WIN_LINK -Force -Recurse }; New-Item -ItemType Junction -Path $env:WIN_LINK -Target $env:WIN_TARGET' > /dev/null
        ;;
    *)
        # only when wrong: re-pointing it on every build races with concurrent builds
        if [ "$(readlink "$QB64_DIR/assets")" != "$(realpath .)/assets" ]; then
            ln -sfn "$(realpath .)/assets" "$QB64_DIR/assets"
        fi
        ;;
esac


# Inputs as they are when the compile starts: an edit made during the build must show as stale next time
build_manifest=$(mktemp)
"$(dirname "$0")/build-manifest" "$1" > "$build_manifest" || exit 1

# Remove stale executable so a failed build can't be mistaken for success
rm -f "$old_exe" "$old_exe.sha1" "$old_exe.manifest"
echo ">>> Building $1..."
# -o, not -s:ExeDefaultDir: -s saves into QB64-PE's config.ini on every build
mkdir -p ./builds "$(dirname "$old_exe")"
out_abs="$(cd "$(dirname "$old_exe")" && pwd -P)/$(basename "$old_exe")"
# Linux: link against an unversioned libcurl stub, as CI does, so the binary loads cleanly on Fedora too (#303)
link_flags=()
if [ "$(uname -s)" = Linux ]; then
    curl_stub_dir=$(mktemp -d)
    curl_link_flags=$("$(dirname "$0")/curl-link-stub" "$curl_stub_dir") || exit 1
    # Release only: the binary carries libstdc++/libgcc itself, so it needs no matching runtime on the player's distro (#352)
    if [ "${SSS_RELEASE:-}" = 1 ]; then
        curl_link_flags="$curl_link_flags -static-libstdc++ -static-libgcc -Wl,--as-needed"
    fi
    link_flags=("-f:ExtraLinkerFlags=$curl_link_flags")
fi
build_output=$(qb64pe -w -x "$1" ${link_flags[@]+"${link_flags[@]}"} -o "$out_abs" 2>&1)

build_status=$?
[ -n "${curl_stub_dir:-}" ] && rm -rf "$curl_stub_dir"
echo "$build_output"

if [ $build_status -ne 0 ] || echo "$build_output" | grep -Eiq 'error|fatal' || [ ! -x "$old_exe" ]; then
    echo "Error: build failed for '$base'" >&2
    exit 1
fi

mv -f "$build_manifest" "$old_exe.manifest"
if command -v sha1sum > /dev/null 2>&1; then sha1sum < "$old_exe.manifest"; else shasum -a 1 < "$old_exe.manifest"; fi | cut -d" " -f1 > "$old_exe.sha1"
echo ">>> done!"

if [ "$2" == "/run" ]; then
    "$old_exe" "${@:3}"
fi