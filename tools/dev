#!/usr/bin/env bash
# tools/dev -- build, test, and regenerate SSS inside a container (Podman or Docker).
#
# Usage: tools/dev <command> [args]
#   image          build (or rebuild) the dev image from tools/container/Containerfile
#   build          tools/buildqb sss.bas, then the builds/sss --version smoke test
#   build --release  a release build (no dev-only flags) into builds/sss, then
#                  tests/release_build_test.sh
#   test           the full test suite (.github/scripts/qb64test.sh, same as CI)
#   render [args]  golden-screenshot render tests (tests/render/run.sh; --update
#                  re-blesses the goldens)
#   bake           tools/bake_speech_dict
#   emit           npm install in math/, then node tools/emit-spline.js
#   shell [cmd]    interactive shell in the container, or run one command
#   run [args]     play the game: builds/sss (rebuilt first if missing or older
#                  than any source) on your display and audio (X11/XWayland,
#                  PulseAudio/PipeWire, /dev/dri, controllers via /dev/input)
#   headless [args]  builds/sss on an off-screen X server (Xvfb), no display or
#                  audio needed; pair with --input-script/--frames/--seed for
#                  scripted playtests
#   record [opts] [sss args]  record a scripted run, picture and sound, to an
#                  MP4, headless (Xvfb + a null PulseAudio sink + ffmpeg).
#                  Default: the full playthrough to builds/playthrough.mp4.
#                    --out FILE      output file (default builds/playthrough.mp4)
#                    --script FILE   input script (default
#                                    tests/playthrough/playthrough.txt)
#                    --frames N      quit after N frames (default 20000)
#                    --seed N        random seed (default 1)
#                    --scale N       integer upscale, nearest-neighbour (default 2)
#                    --timeout S     wall-clock limit (default frames/60 + 120)
#                    --rebuild       rebuild builds/record/sss even if it's current
#                  Other args go to sss in place of the default --god --nerf
#                  (e.g. --scene boss3 --god). Plays its own binary,
#                  builds/record/sss, built with assets/.env masked, so it never
#                  sends telemetry; builds/sss and assets/.env are left alone.
#
# The repo is bind-mounted at its host path, so builds/ and every generated
# file land on the host owned by you. Only `run` touches your display/audio.
#
# Env overrides:
#   SSS_ENGINE=podman|docker   force an engine (default: podman if found, else docker)
#   SSS_IMAGE=<name>           image tag (default: localhost/sss-dev:latest)
#   SSS_DEV_DRYRUN=1           print the engine command line instead of running
#                              it, without probing the engine or (re)building
set -euo pipefail

REPO="$(cd "$(dirname "$0")/.." && pwd)"
IMAGE="${SSS_IMAGE:-localhost/sss-dev:latest}"
CONTAINER_DIR="$REPO/tools/container"

usage() {
    sed -n '2,44p' "$0" | sed 's/^# \{0,1\}//'
}

DRYRUN="${SSS_DEV_DRYRUN:-}"

pick_engine() {
    if [ "$DRYRUN" = 1 ]; then
        ENGINE="${SSS_ENGINE:-podman}"
        return
    fi
    if [ -n "${SSS_ENGINE:-}" ]; then
        ENGINE="$SSS_ENGINE"
    elif command -v podman > /dev/null 2>&1; then
        ENGINE=podman
    elif command -v docker > /dev/null 2>&1; then
        ENGINE=docker
    else
        echo "Error: neither podman nor docker found in PATH" >&2
        exit 1
    fi
    if ! command -v "$ENGINE" > /dev/null 2>&1; then
        echo "Error: SSS_ENGINE=$ENGINE but '$ENGINE' is not in PATH" >&2
        exit 1
    fi
}

build_image() {
    echo ">>> Building $IMAGE with $ENGINE..."
    "$ENGINE" build -t "$IMAGE" -f "$CONTAINER_DIR/Containerfile" "$CONTAINER_DIR"
}

ensure_image() {
    [ "$DRYRUN" = 1 ] && return
    if !"$ENGINE" image inspect "$IMAGE" > /dev/null 2>&1; then
        build_image
    fi
}

# Rebuild when the binary is missing or any game source is newer than it (e.g.
# after a git pull), so `run`/`headless` never play a stale build.
# Also rebuild a binary built natively on the host: it can need a newer glibc
# than the container has ("GLIBC_2.xx not found").
rebuild_if_stale() {
    [ "$DRYRUN" = 1 ] && return
    if [ ! -x "$REPO/builds/sss" ] || [ -n "$(cd "$REPO" && find sss.bas src assets VERSION -newer builds/sss -print -quit)" ]; then
        echo ">>> sources changed since the last build; rebuilding builds/sss..."
        run_in bash -c "./tools/buildqb sss.bas"
    elif ! run_in bash -c '! ldd builds/sss 2>&1 | grep -q "not found"'; then
        echo ">>> builds/sss was built outside the container; rebuilding it here..."
        run_in bash -c "./tools/buildqb sss.bas"
    fi
}

# Extra engine args for the next run_in (set by gui_args).
RUN_EXTRA=()

# Runs "$@" inside the container with the repo as the working directory.
run_in() {
    local args=(run --rm -i --init)
    [ -t 0 ] && [ -t 1 ] && args+=(-t)

    # Make files the container writes belong to the host user.
    if [ "$ENGINE" = podman ]; then
        args+=(--userns=keep-id)
    elif "$ENGINE" info --format '{{.SecurityOptions}}' 2> /dev/null | grep -q rootless; then
        : # rootless Docker: container root already maps to the host user
    else
        args+=(--user "$(id -u):$(id -g)")
    fi

    # Same path inside and out, so worktree .git pointers and absolute paths
    # in build output stay valid. :Z relabels for SELinux (no-op elsewhere).
    args+=(-v "$REPO:$REPO:Z" -w "$REPO")

    # A git worktree's .git is a file pointing at the main checkout's git dir;
    # mount that too so make-version.sh and buildqb's git checks work.
    local common
    common="$(git -C "$REPO" rev-parse --path-format=absolute --git-common-dir 2> /dev/null || true)"
    if [ -n "$common" ] && [ -d "$common" ]; then
        case "$common/" in
            "$REPO"/*) ;;
            *) args+=(-v "$common:$common:z") ;;
        esac
    fi

    if [ "$DRYRUN" = 1 ]; then
        printf '%q ' "$ENGINE" "${args[@]}" "${RUN_EXTRA[@]}" "$IMAGE" "$@"
        echo
        return
    fi
    "$ENGINE" "${args[@]}" "${RUN_EXTRA[@]}" "$IMAGE" "$@"
}

# Pass the host display, audio, GPU and controllers through for `run`. The sockets are
# shared rather than relabeled, so SELinux labeling is off for this container.
# --ipc=host lets X11 MIT-SHM work.
gui_args() {
    if [ -z "${DISPLAY:-}" ]; then
        echo "Error: DISPLAY is not set; run needs an X11 or XWayland session" >&2
        exit 1
    fi
    RUN_EXTRA+=(--security-opt label=disable --ipc=host
                -e DISPLAY -v /tmp/.X11-unix:/tmp/.X11-unix)
    if [ -n "${XAUTHORITY:-}" ] && [ -f "$XAUTHORITY" ]; then
        RUN_EXTRA+=(-v "$XAUTHORITY:/tmp/.Xauthority:ro" -e XAUTHORITY=/tmp/.Xauthority)
    fi
    local pulse="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/pulse/native"
    if [ -S "$pulse" ]; then
        RUN_EXTRA+=(-v "$pulse:/tmp/pulse-native" -e PULSE_SERVER=unix:/tmp/pulse-native)
    else
        echo "Warning: no PulseAudio/PipeWire socket at $pulse; the game will be silent" >&2
    fi
    if [ -e /dev/dri ]; then
        RUN_EXTRA+=(--device /dev/dri)
    fi
    # A bind mount, not --device, so a controller plugged in after launch shows up too.
    if [ -d /dev/input ]; then
        RUN_EXTRA+=(-v /dev/input:/dev/input)
    fi
}

SMOKE='
set -euo pipefail
out=$(xvfb-run -a builds/sss --version | tr -d "\r")
echo "$out"
base=$(tr -d "[:space:]" < VERSION)
echo "$out" | grep -qE "Super Spaceguy Shooter ${base}(-dev\+[0-9a-f]+(-dirty)?)?$" || {
    echo "Error: --version smoke test failed: expected a version starting with ${base}" >&2
    exit 1
}
echo ">>> smoke test passed"
'

# `record`, inside the container: $1 game binary, $2 output file, $3 scale, $4 time limit, then the sss
# args. Its own X server and a PulseAudio server whose only sink is a null sink, so the
# game's sound goes nowhere but ffmpeg; the game runs from a fresh launch folder (no
# saved settings or callsign), exactly as tests/playthrough/run.sh does.
RECORD='
set -uo pipefail
bin=$1 out=$2 scale=$3 limit=$4
shift 4
for tool in Xvfb xdpyinfo pulseaudio pactl ffmpeg; do
    command -v "$tool" > /dev/null || {
        echo "Error: the dev image has no $tool; rebuild it with: tools/dev image" >&2
        exit 1
    }
done
launch=$(mktemp -d)
export XDG_RUNTIME_DIR=$(mktemp -d) DISPLAY=:99
pids=()
cleanup() {
    [ ${#pids[@]} -gt 0 ] && kill "${pids[@]}" 2> /dev/null
    wait 2> /dev/null
}
trap cleanup EXIT

# 320x240 is the game window, fullscreen or not
Xvfb :99 -screen 0 320x240x24 -nolisten tcp > "$launch/xvfb.log" 2>&1 &
pids+=($!)
pulseaudio -n --daemonize=no --exit-idle-time=-1 \
    --load=module-native-protocol-unix --load="module-null-sink sink_name=rec" \
    > "$launch/pulse.log" 2>&1 &
pids+=($!)
for _ in $(seq 100); do
    xdpyinfo > /dev/null 2>&1 && pactl info > /dev/null 2>&1 && break
    sleep 0.1
done
xdpyinfo > /dev/null 2>&1 || { echo "Error: Xvfb did not start:" >&2; cat "$launch/xvfb.log" >&2; exit 1; }
pactl info > /dev/null 2>&1 || { echo "Error: PulseAudio did not start:" >&2; cat "$launch/pulse.log" >&2; exit 1; }

ffmpeg -nostdin -hide_banner -loglevel warning -y \
    -thread_queue_size 1024 -f x11grab -draw_mouse 0 -framerate 60 -video_size 320x240 -i :99 \
    -thread_queue_size 1024 -f pulse -i rec.monitor \
    -vf "scale=iw*$scale:ih*$scale:flags=neighbor" \
    -c:v libx264 -preset veryfast -crf 18 -pix_fmt yuv420p \
    -c:a aac -b:a 192k -movflags +faststart "$out" > "$launch/ffmpeg.log" 2>&1 &
ff=$!
pids+=($ff)

echo ">>> recording: sss $*"
start=$SECONDS
(cd "$launch" && timeout -k 5 "$limit" "$bin" "$@" > game.out 2>&1)
rc=$?
echo ">>> game exited with $rc after $((SECONDS - start))s"
sleep 1    # let the last sound reach the recording
kill -TERM "$ff" 2> /dev/null
wait "$ff" 2> /dev/null

game_log() { grep -v "^ALSA lib" "$launch/game.out" | tail -n 20 >&2; }
if [ "$rc" -eq 124 ] || [ "$rc" -eq 137 ]; then
    echo "Error: still running after ${limit}s (hung, or an error dialog); stopped it" >&2
    game_log
    exit 1
elif [ "$rc" -ne 0 ]; then
    echo "Error: the game exited with status $rc" >&2
    game_log
    exit 1
fi
if [ ! -s "$out" ]; then
    echo "Error: ffmpeg wrote no video:" >&2
    cat "$launch/ffmpeg.log" >&2
    exit 1
fi
'

cmd="${1:-}"
[ $# -gt 0 ] && shift

case "$cmd" in
    image)
        pick_engine
        build_image
        ;;
    build)
        pick_engine; ensure_image
        if [ "${1:-}" = --release ]; then
            run_in bash -c "./tools/buildqb --release sss.bas && bash tests/release_build_test.sh"
        else
            run_in bash -c "./tools/buildqb sss.bas && $SMOKE"
        fi
        ;;
    test)
        pick_engine; ensure_image
        run_in bash .github/scripts/qb64test.sh
        ;;
    render)
        pick_engine; ensure_image
        run_in bash tests/render/run.sh "$@"
        ;;
    bake)
        pick_engine; ensure_image
        run_in bash tools/bake_speech_dict
        ;;
    emit)
        pick_engine; ensure_image
        run_in bash -c '(cd math && npm install) && node tools/emit-spline.js'
        ;;
    shell)
        pick_engine; ensure_image
        if [ $# -gt 0 ]; then
            run_in "$@"
        else
            run_in bash
        fi
        ;;
    run)
        pick_engine; ensure_image
        rebuild_if_stale
        gui_args
        run_in builds/sss "$@"
        ;;
    headless)
        pick_engine; ensure_image
        rebuild_if_stale
        # Off-screen X server; the container has no sound card, so drop ALSA's noise.
        run_in bash -c 'set -o pipefail; xvfb-run -a -s "-screen 0 1280x720x24" builds/sss "$@" 2>&1 | { grep -v "^ALSA lib" || true; }' headless "$@"
        ;;
    record)
        rec_out=builds/playthrough.mp4
        rec_script=tests/playthrough/playthrough.txt
        rec_frames=20000 rec_seed=1 rec_scale=2 rec_timeout= rec_rebuild=0
        rec_args=()
        rec_need() {
            [ $# -ge 2 ] && [ -n "$2" ] || { echo "Error: $1 needs a value" >&2; exit 1; }
        }
        rec_num() {
            [[ "$2" =~ ^[0-9]+$ ]] && [ "$2" -ge "$3" ] || {
                echo "Error: $1 needs a whole number $3 or more, got '$2'" >&2
                exit 1
            }
        }
        while [ $# -gt 0 ]; do
            case "$1" in
                --out)     rec_need "$@"; rec_out="$2"; shift 2 ;;
                --script)  rec_need "$@"; rec_script="$2"; shift 2 ;;
                --frames)  rec_need "$@"; rec_num "$1" "$2" 1; rec_frames="$2"; shift 2 ;;
                --seed)    rec_need "$@"; rec_num "$1" "$2" 0; rec_seed="$2"; shift 2 ;;
                --scale)   rec_need "$@"; rec_num "$1" "$2" 1; rec_scale="$2"; shift 2 ;;
                --timeout) rec_need "$@"; rec_num "$1" "$2" 1; rec_timeout="$2"; shift 2 ;;
                --rebuild) rec_rebuild=1; shift ;;
                --)        shift; rec_args+=("$@"); break ;;
                *)         rec_args+=("$1"); shift ;;
            esac
        done
        [ ${#rec_args[@]} -eq 0 ] && rec_args=(--god --nerf)
        [ -n "$rec_timeout" ] || rec_timeout=$((rec_frames / 60 + 120))

        # The container sees only the repo, so the script must be inside it.
        case "$rec_script" in /*) ;; *) rec_script="$PWD/$rec_script" ;; esac
        [ -f "$rec_script" ] || { echo "Error: no input script at $rec_script" >&2; exit 1; }
        rec_script="$(cd "$(dirname "$rec_script")" && pwd)/$(basename "$rec_script")"
        case "$rec_script" in
            "$REPO"/*) ;;
            *) echo "Error: the input script must be inside the repo ($REPO): $rec_script" >&2; exit 1 ;;
        esac
        # Record into builds/ (mounted), then move it wherever --out says.
        case "$rec_out" in /*) ;; *) rec_out="$PWD/$rec_out" ;; esac
        rec_tmp="$REPO/builds/.record-$$.mp4"

        pick_engine; ensure_image
        [ "$DRYRUN" = 1 ] || mkdir -p "$REPO/builds" "$(dirname "$rec_out")"
        rec_start=$SECONDS

        # The run OKs the data notice, so a binary with telemetry credentials would send
        # its telemetry and post its score to the real leaderboard. Record with a binary
        # of its own, builds/record/sss, built with an empty file mounted over
        # assets/.env; your assets/.env and builds/sss are left alone.
        rec_bin="$REPO/builds/record/sss"
        rec_env="$REPO/builds/record/env-empty"
        if [ "$rec_rebuild" = 1 ] || [ "$DRYRUN" = 1 ] || [ ! -x "$rec_bin" ] ||
            [ -n "$(cd "$REPO" && find sss.bas src assets VERSION ! -path assets/.env -newer "$rec_bin" -print -quit)" ]; then
            echo ">>> building $rec_bin without telemetry credentials..."
            if [ "$DRYRUN" != 1 ]; then
                mkdir -p "$(dirname "$rec_bin")"
                : > "$rec_env"
            fi
            RUN_EXTRA=(-e SSS_BUILD_OUT=builds/record/sss)
            [ -f "$REPO/assets/.env" ] && RUN_EXTRA+=(-v "$rec_env:$REPO/assets/.env:Z")
            run_in ./tools/buildqb sss.bas || exit 1
            RUN_EXTRA=()
        fi
        if [ "$DRYRUN" != 1 ]; then
            rec_url="$(sed -n 's/^DB_URL=//p' "$REPO/assets/.env" 2> /dev/null | head -n 1 | tr -d '\r')"
            if grep -aqE 'DB_(URL|KEY)=.' "$rec_bin" || { [ -n "$rec_url" ] && grep -aqF -- "$rec_url" "$rec_bin"; }; then
                rm -f "$rec_bin"
                echo "Error: $rec_bin has telemetry credentials embedded; deleted it, not recording" >&2
                exit 1
            fi
        fi

        if ! run_in bash -c "$RECORD" record "$rec_bin" "$rec_tmp" "$rec_scale" "$rec_timeout" \
                "${rec_args[@]}" --realtime --seed "$rec_seed" --frames "$rec_frames" \
                --input-script "$rec_script"; then
            rm -f "$rec_tmp"
            exit 1
        fi
        [ "$DRYRUN" = 1 ] && exit 0
        mv -f "$rec_tmp" "$rec_out"
        echo ">>> wrote $rec_out ($((SECONDS - rec_start))s)"
        ;;
    -h|--help|help|"")
        usage
        ;;
    *)
        echo "Error: unknown command '$cmd'" >&2
        usage >&2
        exit 1
        ;;
esac
