#!/usr/bin/env bash
# tools/dev -- build, test, and regenerate SSS inside a container (Podman or Docker).
#
# Usage: tools/dev <command> [args]
#   image          build (or rebuild) the dev image from tools/container/Containerfile
#   build          tools/buildqb sss.bas, then the builds/sss --version smoke test
#   build --release  a release build (no dev-only flags) into builds/sss, then
#                  tests/release_build_test.sh
#   test           the full test suite (.github/scripts/qb64test.sh, same as CI)
#   render [args]  golden-screenshot render tests (tests/render/run.sh; --update
#                  re-blesses the goldens)
#   bake           tools/bake_speech_dict
#   shell [cmd]    interactive shell in the container, or run one command
#   run [args]     play the game: builds/sss (rebuilt first if missing or stale
#                  against its sources: content hash, #233) on your display and audio (X11/XWayland,
#                  PulseAudio/PipeWire, /dev/dri, controllers via /dev/input)
#   headless [args]  builds/sss on an off-screen X server (Xvfb), no display or
#                  audio needed; pair with --input-script/--frames/--seed for
#                  scripted playtests
#   viewer [args]  build viewer.bas and open the model viewer on your display
#                  (PgUp/PgDn cycle meshes, old enemy then its E2_ replacement);
#                  args go to the viewer, e.g. --sheets <outdir> writes the review PNGs
#   speechtune [--rebuild] [--build-only] [args]  build tools/speechtune.bas only when it or its sources changed
#                  (--rebuild forces it, --build-only stops after the build), then open the voice-tuning tool on your display and audio
#                  (settings list, scrubbing player, saves assets/config/speech.ini); `speechtune --screenshot <png> [--line N]` draws one
#                  frame headless into a repo-relative PNG and exits
#   bench [--repeat N] [--script F] [args]  frame-time bench: plays F (default tests/bench/bench.txt) headless,
#                  unthrottled, N times (default 5); prints avg, p95 and worst
#                  per phase (simulation, backdrop, scene build, raster, particles,
#                  overlay, effects, HUD) and the spread across runs
#   record [opts] [sss args]  record a scripted run, picture and sound, to an
#                  MP4, headless (Xvfb + a null PulseAudio sink + ffmpeg).
#                  Default: the full playthrough to builds/playthrough.mp4.
#                    --out FILE      output file (default builds/playthrough.mp4)
#                    --script FILE   input script (default
#                                    tests/playthrough/playthrough.txt)
#                    --frames N      quit after N frames (default 20000)
#                    --seed N        random seed (default 1)
#                    --scale N       integer upscale, nearest-neighbour (default 2)
#                    --timeout S     wall-clock limit (default frames/60 + 120)
#                    --rebuild       rebuild builds/record/sss even if it's current
#                  Other args go to sss in place of the default --god --nerf
#                  (e.g. --scene boss3 --god). Plays its own binary,
#                  builds/record/sss, built with assets/.env masked, so it never
#                  sends telemetry; builds/sss and assets/.env are left alone.
#   completion     print a bash completion function for tools/dev; enable it with
#                  source <(path/to/tools/dev completion) in ~/.bashrc
#
# The repo is bind-mounted at its host path, so builds/ and every generated
# file land on the host owned by you. Only `run` touches your display/audio.
# What runs inside the container lives in tools/container/in/ (one script per
# command that needs more than a single command line).
#
# Env overrides:
#   SSS_ENGINE=podman|docker   force an engine (default: podman if found, else docker)
#   SSS_IMAGE=<name>           image tag (default: localhost/sss-dev:latest)
#   SSS_DEV_DRYRUN=1           print the engine command line instead of running
#                              it, without probing the engine or (re)building
#
# Limits (every container run except the game window; 0 or "none" turns one off; see docs/container.md):
#   SSS_DEV_TIMEOUT=SECS       wall-clock limit for build, test, render and bench (default 3600);
#                              run, headless, shell, record and bake have none
#   SSS_DEV_MEMORY=SIZE        container RAM limit, also the memory+swap limit (default 4g)
#   SSS_DEV_CPUS=N             CPUs the container may use (default 3)
#   SSS_DEV_PIDS=N             process limit (default 512)
#   SSS_DEV_RUN_LIMITS=1       also apply the memory, CPU and pid limits to `run` and the viewer
#                              window (default: they have none, so the game never stalls on a
#                              CPU quota)
#   SSS_DEV_JOBS=N             parallel test workers for `test` (default 3; CI uses every CPU)
#   SSS_DEV_SLOTS=N            build, test, render and bench wait for one of N slots, so
#                              concurrent runs queue (default 2; 0 = no waiting)
#   SSS_DEV_SLOT_WAIT=SECS     give up waiting for a slot after SECS (default: wait)
#   SSS_DEV_LOCKDIR=DIR        where the slot lock files live (default <git dir>/sss-dev-slots)
#   SSS_DEV_NOTTY_TIMEOUT=SECS wall-clock limit for every other container run (shell, headless,
#                              bake, record, viewer --sheets) when stdin or stdout is not a terminal
#                              (default 600; 0 = none). `run` and the viewer window are exempt.
#   SSS_DEV_STDIN=keep         without a terminal, keep the caller's stdin (default: /dev/null, so a
#                              program that reads stdin sees EOF instead of waiting)
set -euo pipefail

REPO="$(cd "$(dirname "$0")/.." && pwd)"
IMAGE="${SSS_IMAGE:-localhost/sss-dev:latest}"
CONTAINER_DIR="$REPO/tools/container"

usage() {
    sed -n "2,75p" "$0" | sed 's/^# \{0,1\}//'
}

DRYRUN="${SSS_DEV_DRYRUN:-}"

# Limits on every container (#427). A value of 0 or "none" turns one off.
LIM_MEMORY="${SSS_DEV_MEMORY:-4g}"
LIM_CPUS="${SSS_DEV_CPUS:-3}"
LIM_PIDS="${SSS_DEV_PIDS:-512}"
LIM_JOBS="${SSS_DEV_JOBS:-3}"
LIM_SLOTS="${SSS_DEV_SLOTS:-2}"
LIM_TIMEOUT="${SSS_DEV_TIMEOUT:-3600}"
LIM_NOTTY_TIMEOUT="${SSS_DEV_NOTTY_TIMEOUT:-600}"
# The timeout the next run_in applies (seconds; empty = none). The heavy commands set it.
RUN_TIMEOUT=""
# Set by commands that may run unattended for long on purpose (the game window).
NOTTY_EXEMPT=0
# Set by gui_args: the container is an interactive game session. It gets no CPU, memory or pid
# limit unless SSS_DEV_RUN_LIMITS=1: a CFS quota freezes the whole container (game loop and
# audio feeder included) for the rest of a 100 ms period once it is used up.
GAME_SESSION=0

limit_on() { [ -n "$1" ] && [ "$1" != 0 ] && [ "$1" != none ]; }

# Waits for one of LIM_SLOTS slots (flock on slot.1 ... slot.N under the lock dir), so
# concurrent heavy runs queue instead of piling up. The lock is held by this script and
# its children until it exits. Without flock (macOS) there is no queueing.
acquire_slot() {
    [ "$DRYRUN" = 1 ] && return
    limit_on "$LIM_SLOTS" || return 0
    if ! command -v flock > /dev/null 2>&1; then
        echo "Warning: no flock; not queueing for a build slot" >&2
        return 0
    fi
    local dir="${SSS_DEV_LOCKDIR:-}" i waited=0 start=$SECONDS
    if [ -z "$dir" ]; then
        dir="$(git -C "$REPO" rev-parse --path-format=absolute --git-common-dir 2> /dev/null || true)"
        [ -d "$dir" ] || dir="${XDG_RUNTIME_DIR:-/tmp}"
        dir="$dir/sss-dev-slots"
    fi
    mkdir -p "$dir"
    while :; do
        for ((i = 1; i <= LIM_SLOTS; i++)); do
            exec 9>> "$dir/slot.$i"
            if flock -n 9; then
                [ "$waited" = 0 ] || echo ">>> got build slot $i after $((SECONDS - start))s" >&2
                return 0
            fi
            exec 9>&-
        done
        if [ "$waited" = 0 ]; then
            echo ">>> waiting for a build slot (all $LIM_SLOTS in use; SSS_DEV_SLOTS changes the count)..." >&2
            waited=1
        fi
        if limit_on "${SSS_DEV_SLOT_WAIT:-}" && [ $((SECONDS - start)) -ge "$SSS_DEV_SLOT_WAIT" ]; then
            echo "Error: no build slot free after ${SSS_DEV_SLOT_WAIT}s" >&2
            exit 1
        fi
        sleep 2
    done
}

pick_engine() {
    if [ "$DRYRUN" = 1 ]; then
        ENGINE="${SSS_ENGINE:-podman}"
        return
    fi
    if [ -n "${SSS_ENGINE:-}" ]; then
        ENGINE="$SSS_ENGINE"
    elif command -v podman > /dev/null 2>&1; then
        ENGINE=podman
    elif command -v docker > /dev/null 2>&1; then
        ENGINE=docker
    else
        echo "Error: neither podman nor docker found in PATH" >&2
        exit 1
    fi
    if ! command -v "$ENGINE" > /dev/null 2>&1; then
        echo "Error: SSS_ENGINE=$ENGINE but '$ENGINE' is not in PATH" >&2
        exit 1
    fi
}

build_image() {
    echo ">>> Building $IMAGE with $ENGINE..."
    "$ENGINE" build -t "$IMAGE" -f "$CONTAINER_DIR/Containerfile" "$CONTAINER_DIR"
}

ensure_image() {
    [ "$DRYRUN" = 1 ] && return
    if ! "$ENGINE" image inspect "$IMAGE" > /dev/null 2>&1; then
        build_image
    fi
}

# Rebuild unless builds/sss is current with its inputs (a content hash of the includes, embedded
# assets, VERSION and git state: tools/buildqb --check, #233), so `run`/`headless`/`bench` never
# play a stale build after a git pull or an edit. Also rebuild a binary built natively on the
# host: it can need a newer glibc than the container has ("GLIBC_2.xx not found").
rebuild_if_stale() {
    [ "$DRYRUN" = 1 ] && return
    if ! run_in tools/container/in/current.sh; then
        run_in ./tools/buildqb sss.bas
    fi
}

# Extra engine args for the next run_in (set by gui_args).
RUN_EXTRA=()

# Runs "$@" inside the container with the repo as the working directory.
run_in() {
    local args=(run --rm -i --init) cname="sss-dev-$$-$RANDOM"
    # Bounded: memory (and swap, so it cannot thrash), CPUs, processes, and no container log
    # (a looping program once filled the journal through it).
    if [ "$GAME_SESSION" != 1 ] || [ "${SSS_DEV_RUN_LIMITS:-}" = 1 ]; then
        limit_on "$LIM_MEMORY" && args+=(--memory "$LIM_MEMORY" --memory-swap "$LIM_MEMORY")
        limit_on "$LIM_CPUS" && args+=(--cpus "$LIM_CPUS")
        limit_on "$LIM_PIDS" && args+=(--pids-limit "$LIM_PIDS")
    fi
    args+=(--log-driver none --name "$cname")
    limit_on "$LIM_JOBS" && args+=(-e "QB64_TEST_JOBS=$LIM_JOBS")
    # Without a terminal (an agent, CI, a pipe): stdin is /dev/null, and a command with no
    # limit of its own gets the no-terminal one. The engine enforces it inside the container
    # too (podman --timeout), so it still holds if the client is killed or a pipe closes.
    local notty=1 nullin=0 rt="$RUN_TIMEOUT"
    if [ -t 0 ] && [ -t 1 ]; then
        notty=0
        args+=(-t)
    else
        [ "${SSS_DEV_STDIN:-}" = keep ] || nullin=1
        if ! limit_on "$rt" && [ "$NOTTY_EXEMPT" != 1 ]; then rt="$LIM_NOTTY_TIMEOUT"; fi
    fi
    if limit_on "$rt" && [ "$ENGINE" = podman ]; then
        args+=(--timeout "$rt")
    fi

    # Make files the container writes belong to the host user.
    if [ "$ENGINE" = podman ]; then
        args+=(--userns=keep-id)
    elif "$ENGINE" info --format '{{.SecurityOptions}}' 2> /dev/null | grep -q rootless; then
        : # rootless Docker: container root already maps to the host user
    else
        args+=(--user "$(id -u):$(id -g)")
    fi

    # Same path inside and out, so worktree .git pointers and absolute paths
    # in build output stay valid. :z relabels for SELinux with a shared label (no-op elsewhere), so
    # concurrent runs and worktrees do not lock each other out as a private :Z label would.
    args+=(-v "$REPO:$REPO:z" -w "$REPO")

    # A git worktree's .git is a file pointing at the main checkout's git dir;
    # mount that too so make-version.sh and buildqb's git checks work.
    local common
    common="$(git -C "$REPO" rev-parse --path-format=absolute --git-common-dir 2> /dev/null || true)"
    if [ -n "$common" ] && [ -d "$common" ]; then
        case "$common/" in
            "$REPO"/*) ;;
            *) args+=(-v "$common:$common:z") ;;
        esac
    fi

    local wrap=()
    if limit_on "$rt"; then
        wrap=(timeout -k 20)
        [ "$notty" = 0 ] && wrap+=(--foreground)
        wrap+=("$rt")
    fi
    if [ "$DRYRUN" = 1 ]; then
        printf '%q ' ${wrap[@]+"${wrap[@]}"} "$ENGINE" "${args[@]}" "${RUN_EXTRA[@]}" "$IMAGE" "$@"
        echo
        return
    fi
    local rc=0
    if [ "$nullin" = 1 ]; then
        ${wrap[@]+"${wrap[@]}"} "$ENGINE" "${args[@]}" "${RUN_EXTRA[@]}" "$IMAGE" "$@" < /dev/null || rc=$?
    else
        ${wrap[@]+"${wrap[@]}"} "$ENGINE" "${args[@]}" "${RUN_EXTRA[@]}" "$IMAGE" "$@" || rc=$?
    fi
    if [ "$rc" = 124 ] || [ "$rc" = 137 ]; then
        # timeout stopped the client; make sure the container goes too
        "$ENGINE" rm -f "$cname" > /dev/null 2>&1 || true
        [ "$rc" = 124 ] && echo "Error: stopped after ${rt}s (SSS_DEV_TIMEOUT, SSS_DEV_NOTTY_TIMEOUT)" >&2
    fi
    return "$rc"
}

# Pass the host display, audio, GPU and controllers through for `run`. The sockets are
# shared rather than relabeled, so SELinux labeling is off for this container.
# --ipc=host lets X11 MIT-SHM work.
gui_args() {
    if [ -z "${DISPLAY:-}" ]; then
        echo "Error: DISPLAY is not set; run needs an X11 or XWayland session" >&2
        exit 1
    fi
    GAME_SESSION=1
    RUN_EXTRA+=(--security-opt label=disable --ipc=host
                -e DISPLAY -v /tmp/.X11-unix:/tmp/.X11-unix)
    if [ -n "${XAUTHORITY:-}" ] && [ -f "$XAUTHORITY" ]; then
        RUN_EXTRA+=(-v "$XAUTHORITY:/tmp/.Xauthority:ro" -e XAUTHORITY=/tmp/.Xauthority)
    fi
    local pulse="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/pulse/native"
    if [ -S "$pulse" ]; then
        RUN_EXTRA+=(-v "$pulse:/tmp/pulse-native" -e PULSE_SERVER=unix:/tmp/pulse-native)
    else
        echo "Warning: no PulseAudio/PipeWire socket at $pulse; the game will be silent" >&2
    fi
    if [ -e /dev/dri ]; then
        RUN_EXTRA+=(--device /dev/dri)
    fi
    # A bind mount, not --device, so a controller plugged in after launch shows up too.
    if [ -d /dev/input ]; then
        RUN_EXTRA+=(-v /dev/input:/dev/input)
    fi
}

# One cmd_<name> function per command; `tools/dev <name>` runs it, and
# `tools/dev completion` offers the same names.
cmd_image() {
    pick_engine
    build_image
}
cmd_build() {
    pick_engine; acquire_slot; ensure_image
    RUN_TIMEOUT="$LIM_TIMEOUT"
    if [ "${1:-}" = --release ]; then
        run_in tools/container/in/build.sh --release
    else
        run_in tools/container/in/build.sh
    fi
}
cmd_test() {
    pick_engine; acquire_slot; ensure_image
    RUN_TIMEOUT="$LIM_TIMEOUT"
    run_in bash -c 'bash tests/failfast_test.sh && bash .github/scripts/qb64test.sh'
}
cmd_render() {
    pick_engine; acquire_slot; ensure_image
    RUN_TIMEOUT="$LIM_TIMEOUT"
    run_in bash tests/render/run.sh "$@"
}
cmd_bake() {
    pick_engine; ensure_image
    run_in bash tools/bake_speech_dict
}
cmd_shell() {
    pick_engine; ensure_image
    if [ $# -gt 0 ]; then
        run_in "$@"
    else
        run_in bash
    fi
}
cmd_run() {
    pick_engine; ensure_image
    NOTTY_EXEMPT=1
    rebuild_if_stale
    gui_args
    # Settings live in the per-user dir (#284). The container's own home is thrown away with
    # it, so mount the host's settings dir where the game looks, and play shares settings
    # with a native run.
    local cfg="${XDG_CONFIG_HOME:-$HOME/.config}/sss"
    [ "$DRYRUN" = 1 ] || mkdir -p "$cfg"
    RUN_EXTRA+=(-e XDG_CONFIG_HOME=/tmp/sss-config -v "$cfg:/tmp/sss-config/sss")
    run_in builds/sss "$@"
}
cmd_headless() {
    pick_engine; ensure_image
    rebuild_if_stale
    run_in tools/container/in/headless.sh "$@"
}
cmd_viewer() {
    pick_engine; ensure_image
    if [ "${1:-}" = --sheets ]; then
        run_in bash -c './tools/buildqb viewer.bas && exec xvfb-run -a builds/viewer "$@"' viewer "$@"
        return
    fi
    NOTTY_EXEMPT=1
    gui_args
    run_in bash -c './tools/buildqb viewer.bas && exec builds/viewer "$@"' viewer "$@"
}
# The first input newer than builds/speechtune (or "builds/speechtune" if it is missing): the
# tool's source, everything under src/, and the assets it embeds.
speechtune_stale() {
    local bin="$REPO/builds/speechtune" newer
    if [ ! -x "$bin" ]; then
        echo builds/speechtune
        return
    fi
    newer="$(cd "$REPO" && find tools/speechtune.bas src assets/speech_dict.txt assets/gametext.txt \
        assets/gamevalues.ini -type f \( -name '*.bas' -o -name '*.bi' -o -name '*.txt' -o -name '*.ini' \) \
        -newer "$bin" -print -quit)"
    echo "$newer"
}
cmd_speechtune() {
    local force=0 build_only=0 why
    while [ "${1:-}" = --rebuild ] || [ "${1:-}" = --build-only ]; do
        if [ "$1" = --rebuild ]; then force=1; else build_only=1; fi
        shift
    done
    pick_engine; ensure_image
    why="$(speechtune_stale)"
    if [ "$force" = 1 ]; then
        why="--rebuild"
    fi
    if [ -n "$why" ]; then
        echo ">>> Building tools/speechtune.bas (changed: $why)..."
        run_in ./tools/buildqb tools/speechtune.bas || exit 1
    else
        echo ">>> speechtune up to date"
    fi
    [ "$build_only" = 1 ] && return
    if [ "${1:-}" = --screenshot ]; then
        run_in xvfb-run -a builds/speechtune "$@"
        return
    fi
    NOTTY_EXEMPT=1
    gui_args
    run_in builds/speechtune "$@"
}
cmd_bench() {
    pick_engine; acquire_slot; ensure_image
    RUN_TIMEOUT="$LIM_TIMEOUT"
    rebuild_if_stale
    run_in tools/container/in/bench.sh "$@"
}
cmd_record() {
    rec_out=builds/playthrough.mp4
    rec_script=tests/playthrough/playthrough.txt
    rec_frames=20000 rec_seed=1 rec_scale=2 rec_timeout='' rec_rebuild=0
    rec_args=()
    rec_need() {
        if [ $# -lt 2 ] || [ -z "$2" ]; then
            echo "Error: $1 needs a value" >&2
            exit 1
        fi
    }
    rec_num() {
        if ! [[ "$2" =~ ^[0-9]+$ ]] || [ "$2" -lt "$3" ]; then
            echo "Error: $1 needs a whole number $3 or more, got '$2'" >&2
            exit 1
        fi
    }
    while [ $# -gt 0 ]; do
        case "$1" in
            --out)     rec_need "$@"; rec_out="$2"; shift 2 ;;
            --script)  rec_need "$@"; rec_script="$2"; shift 2 ;;
            --frames)  rec_need "$@"; rec_num "$1" "$2" 1; rec_frames="$2"; shift 2 ;;
            --seed)    rec_need "$@"; rec_num "$1" "$2" 0; rec_seed="$2"; shift 2 ;;
            --scale)   rec_need "$@"; rec_num "$1" "$2" 1; rec_scale="$2"; shift 2 ;;
            --timeout) rec_need "$@"; rec_num "$1" "$2" 1; rec_timeout="$2"; shift 2 ;;
            --rebuild) rec_rebuild=1; shift ;;
            --)        shift; rec_args+=("$@"); break ;;
            *)         rec_args+=("$1"); shift ;;
        esac
    done
    [ ${#rec_args[@]} -eq 0 ] && rec_args=(--god --nerf)
    [ -n "$rec_timeout" ] || rec_timeout=$((rec_frames / 60 + 120))

    # The container sees only the repo, so the script must be inside it.
    case "$rec_script" in /*) ;; *) rec_script="$PWD/$rec_script" ;; esac
    [ -f "$rec_script" ] || { echo "Error: no input script at $rec_script" >&2; exit 1; }
    rec_script="$(cd "$(dirname "$rec_script")" && pwd)/$(basename "$rec_script")"
    case "$rec_script" in
        "$REPO"/*) ;;
        *) echo "Error: the input script must be inside the repo ($REPO): $rec_script" >&2; exit 1 ;;
    esac
    # Record into builds/ (mounted), then move it wherever --out says.
    case "$rec_out" in /*) ;; *) rec_out="$PWD/$rec_out" ;; esac
    rec_tmp="$REPO/builds/.record-$$.mp4"

    pick_engine; ensure_image
    [ "$DRYRUN" = 1 ] || mkdir -p "$REPO/builds" "$(dirname "$rec_out")"
    rec_start=$SECONDS

    # The run OKs the data notice, so a binary with telemetry credentials would send
    # its telemetry and post its score to the real leaderboard. Record with a binary
    # of its own, builds/record/sss, built with an empty file mounted over
    # assets/.env; your assets/.env and builds/sss are left alone.
    rec_bin="$REPO/builds/record/sss"
    rec_env="$REPO/builds/record/env-empty"
    if [ "$rec_rebuild" = 1 ] || [ "$DRYRUN" = 1 ] || [ ! -x "$rec_bin" ] ||
        [ -n "$(cd "$REPO" && find sss.bas src assets VERSION ! -path assets/.env -newer "$rec_bin" -print -quit)" ]; then
        echo ">>> building $rec_bin without telemetry credentials..."
        if [ "$DRYRUN" != 1 ]; then
            mkdir -p "$(dirname "$rec_bin")"
            : > "$rec_env"
        fi
        RUN_EXTRA=(-e SSS_BUILD_OUT=builds/record/sss)
        [ -f "$REPO/assets/.env" ] && RUN_EXTRA+=(-v "$rec_env:$REPO/assets/.env:Z")
        run_in ./tools/buildqb sss.bas || exit 1
        RUN_EXTRA=()
    fi
    if [ "$DRYRUN" != 1 ]; then
        rec_url="$(sed -n 's/^DB_URL=//p' "$REPO/assets/.env" 2> /dev/null | head -n 1 | tr -d '\r')"
        if grep -aqE 'DB_(URL|KEY)=.' "$rec_bin" || { [ -n "$rec_url" ] && grep -aqF -- "$rec_url" "$rec_bin"; }; then
            rm -f "$rec_bin"
            echo "Error: $rec_bin has telemetry credentials embedded; deleted it, not recording" >&2
            exit 1
        fi
    fi

    if ! run_in tools/container/in/record.sh "$rec_bin" "$rec_tmp" "$rec_scale" "$rec_timeout" \
            "${rec_args[@]}" --realtime --seed "$rec_seed" --frames "$rec_frames" \
            --input-script "$rec_script"; then
        rm -f "$rec_tmp"
        exit 1
    fi
    [ "$DRYRUN" = 1 ] && exit 0
    mv -f "$rec_tmp" "$rec_out"
    echo ">>> wrote $rec_out ($((SECONDS - rec_start))s)"
}
cmd_help() {
    usage
}

# The game's command-line options, as GAME_Usage in src/sys/game.bas lists them
# (tests/tools_dev_test.sh checks the two match); the list is tools/game_flags.txt.

# Prints a bash completion function for tools/dev. The command list is every cmd_*
# function, the same names the dispatch below runs.
cmd_completion() {
    local cmds GAME_FLAGS
    GAME_FLAGS="$(tr -d '\r' < "$REPO/tools/game_flags.txt" | grep -vE '^[[:space:]]*(#|$)' | tr '\n' ' ')"
    cmds="$(declare -F | sed -n 's/^declare -f cmd_//p' | tr '\n' ' ')"
    printf '_sss_dev_commands=%q\n' "${cmds% }"
    printf '_sss_dev_game_flags=%q\n' "${GAME_FLAGS% }"
    cat << 'EOF'
# Plain bash 3.2 (macOS) and zsh-bashcompinit compatible: no mapfile, BASH_REMATCH
# or ${!array[@]}.

# Scene names for --scene: the "Scene names:" list from the repo's builds/sss --help
# (it prints and exits before the game opens a window), else the scene types.
_sss_dev_scenes() {
    local bin="$1/builds/sss" out="" line w base inner n hi found=0 inlist=0
    if [ -x "$bin" ]; then
        if command -v timeout > /dev/null 2>&1; then
            out="$(timeout 3 "$bin" --help 2> /dev/null)"
        else
            out="$("$bin" --help 2> /dev/null)"
        fi
    fi
    while IFS= read -r line; do
        line="${line%$'\r'}"
        if [ "$inlist" = 0 ]; then
            [ "$line" = "Scene names:" ] && inlist=1
            continue
        fi
        w="${line#"${line%%[![:space:]]*}"}"
        w="${w%%[[:space:]]*}"
        [ -n "$w" ] || continue
        found=1
        case "$w" in
            *\[*\])
                # crawl[0-6] or dock[1,2,3]
                base="${w%%\[*}" inner="${w#*\[}"
                inner="${inner%\]}"
                case "$inner" in
                    *-*)
                        n="${inner%-*}" hi="${inner#*-}"
                        while [ "$n" -le "$hi" ]; do
                            echo "$base$n"
                            n=$((n + 1))
                        done
                        ;;
                    *)
                        for n in ${inner//,/ }; do
                            echo "$base$n"
                        done
                        ;;
                esac
                ;;
            *) echo "$w" ;;
        esac
    done <<< "$out"
    [ "$found" = 1 ] || printf '%s\n' title crawl playing boss dock consent username
}

# Level names for --difficulty: the levels= line of the repo's difficulty.ini.
_sss_dev_difficulties() {
    local line found=0
    if [ -r "$1/assets/config/difficulty.ini" ]; then
        while IFS= read -r line; do
            line="${line%$'\r'}"
            case "$line" in
                levels=*)
                    line="${line#levels=}"
                    printf '%s\n' ${line//,/ }
                    found=1
                    break ;;
            esac
        done < "$1/assets/config/difficulty.ini"
    fi
    [ "$found" = 1 ] || printf '%s\n' easy normal hard
}

# COMPREPLY=(compgen "$@"), one candidate per line, so file names keep their spaces.
_sss_dev_reply() {
    local out
    out="$(compgen "$@")"
    local IFS=$'\n'
    # shellcheck disable=SC2206
    COMPREPLY=($out)
}

_sss_dev() {
    local i=$COMP_CWORD cur="${COMP_WORDS[COMP_CWORD]}" prev sub repo f c words="" joined=0
    # bash splits crawl:key at the colon (COMP_WORDBREAKS); join it back up.
    while [ "$i" -gt 1 ] && { [ "${COMP_WORDS[i]}" = : ] || [ "${COMP_WORDS[i-1]}" = : ]; }; do
        i=$((i - 1))
        cur="${COMP_WORDS[i]}$cur"
        joined=1
    done
    prev="${COMP_WORDS[i-1]}"
    sub="${COMP_WORDS[1]}"
    COMPREPLY=()

    if [ "$i" -le 1 ]; then
        _sss_dev_reply -W "$_sss_dev_commands" -- "$cur"
        return 0
    fi

    repo="${COMP_WORDS[0]/#\~/$HOME}"
    repo="$(cd "$(dirname "$repo")/.." 2> /dev/null && pwd)"

    case "$sub:$prev" in
        build:*)
            words="--release" ;;
        record:--out | record:--script | *:--input-script | *:--leaderboard-file)
            compopt -o filenames 2> /dev/null
            _sss_dev_reply -f -- "$cur"
            return 0 ;;
        record:--scale | record:--timeout | render:--repeat | *:--frames | *:--seed | \
        *:--credits | *:--ships | *:--shields | *:--fuel | *:--screenshot-at)
            return 0 ;;
        *:--scene)
            words="$(_sss_dev_scenes "$repo")" ;;
        *:--pup)
            words="shield fuel points" ;;
        *:--difficulty)
            words="$(_sss_dev_difficulties "$repo")" ;;
        render:*)
            [ "$prev" = --update ] && words="ui gameplay all"
            words="$words --update --no-build --repeat"
            for f in "$repo"/tests/render/scenes/*.txt; do
                [ -e "$f" ] || continue
                f="${f##*/}"
                words="$words ${f%.txt}"
            done
            ;;
        record:*)
            # record sets --frames, --seed and --input-script itself
            words="--frames --seed --scale --out --script --rebuild --timeout"
            for f in $_sss_dev_game_flags; do
                case "$f" in --frames | --seed | --input-script) ;; *) words="$words $f" ;; esac
            done
            ;;
        run:* | headless:*)
            words="$_sss_dev_game_flags" ;;
        *)
            return 0 ;;
    esac
    _sss_dev_reply -W "$words" -- "$cur"
    # bash replaces only the part after the last colon, so hand back just that part.
    if [ "$joined" = 1 ] && [ "${#COMPREPLY[@]}" -gt 0 ]; then
        words=""
        for c in "${COMPREPLY[@]}"; do
            words="$words ${c##*:}"
        done
        _sss_dev_reply -W "$words" -- ""
    fi
    return 0
}
EOF
    printf 'complete -F _sss_dev ./tools/dev tools/dev %q\n' "$REPO/tools/dev"
}

cmd="${1:-}"
[ $# -gt 0 ] && shift
case "$cmd" in
    -h | --help | "") usage ;;
    *)
        if [[ "$cmd" =~ ^[a-z]+$ ]] && declare -F "cmd_$cmd" > /dev/null; then
            "cmd_$cmd" "$@"
        else
            echo "Error: unknown command '$cmd'" >&2
            usage >&2
            exit 1
        fi
        ;;
esac
